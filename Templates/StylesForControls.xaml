<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    

    <Style x:Key="CustomScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid>
                         <!--Полоса движения (зависит от Orientation)--> 
                        <Rectangle>
                            <Rectangle.Style>
                                <Style TargetType="{x:Type Rectangle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}, Path=Orientation}" Value="Horizontal">
                                            <Setter Property="Fill" Value="Transparent"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}, Path=Orientation}" Value="Vertical">
                                            <Setter Property="Fill" Value="Transparent"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>

                         <!--Track для Thumb--> 
                        <Track x:Name="PART_Track">
                             <!--Направление зависит от Orientation--> 
                            <Track.Style>
                                <Style TargetType="{x:Type Track}">
                                    <Setter Property="IsDirectionReversed" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}, Path=Orientation}" Value="Vertical">
                                            <Setter Property="IsDirectionReversed" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Track.Style>
                            <Track.Thumb>
                                 <!--Бегунок (зависит от Orientation)--> 
                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="{x:Type Thumb}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}, Path=Orientation}" Value="Horizontal">
                                                    <Setter Property="MinWidth" Value="15"/>
                                                    <Setter Property="Height" Value="15"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}, Path=Orientation}" Value="Vertical">
                                                    <Setter Property="MinHeight" Value="15"/>
                                                    <Setter Property="Width" Value="15"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Thumb.Style>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="{StaticResource ScrolBarBrush}" CornerRadius="4" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

  

