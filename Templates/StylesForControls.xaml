    <!-- Стиль для кнопки MessageBox -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TitleBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                         CornerRadius="3">
                        <!--<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>-->
                        <!-- Используем TextBlock для переноса текста -->
                        <TextBlock Text="{TemplateBinding Content}" 
                            Foreground="{TemplateBinding Foreground}" 
                            TextWrapping="Wrap" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Padding="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NormalButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Background" Value="#FF555555"/>
    </Style>

