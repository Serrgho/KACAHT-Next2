<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf">

	<Style x:Key="EmoBaseStyle" TargetType="emoji:TextBlock">
		<Setter Property="Height" Value="24"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="TextAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Foreground" Value="{StaticResource SplitterBrush}"/>
	</Style>

	<FontFamily x:Key="DiabloFont">pack://application:,,,/Fonts/exocet.ttf#Exocet Blizzard Mixed Caps</FontFamily>

	<Style x:Key="PopupStyleButton" TargetType="Button">
		<Setter Property="Width" Value="auto"/>
		<Setter Property="Background" Value="{StaticResource AppBackBrush}"/>
		<Setter Property="BorderBrush" Value="Gray"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Padding" Value="5,2,5,2"/>
		<!-- Немного увеличили Padding для красоты -->
		<Setter Property="Margin" Value="2"/>
		<Setter Property="Foreground" Value="Black"/>
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="FontSize" Value="15"/>
		<Setter Property="Cursor" Value="Hand"/>

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
						<!-- Тень сохранена -->
						<Border.Effect>
							<DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="5" ShadowDepth="2" Opacity="0.7"/>
						</Border.Effect>

						<!-- Новая структура для эмодзи и текста -->
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

							<!-- Цветное эмодзи берется из свойства Tag кнопки -->
							<!-- FontSize завязано на FontSize кнопки, чтобы масштабировалось вместе -->
							<emoji:TextBlock Text="{TemplateBinding Tag}" 
                                         FontSize="{TemplateBinding FontSize}" 
                                         VerticalAlignment="Center"/>

							<!-- Текст кнопки берется из свойства Content -->
							<TextBlock Text="{TemplateBinding Content}" 
                                   Margin="5,0,0,0" 
                                   VerticalAlignment="Center"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"/>
						</StackPanel>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<!-- Триггер наведения сохранен -->
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{StaticResource ButtonOverBrush}"/>
			</Trigger>
		</Style.Triggers>
	</Style>


