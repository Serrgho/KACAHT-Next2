    <!--x:Name="SingleleCalendarPopup"-->
    <!--x:Name="MyCalendar0"-->
    <Popup x:Key="SingCal" 
           Placement="Center"
           HorizontalOffset="0"
           VerticalOffset="3"
           PopupAnimation="Slide"
           StaysOpen="False"
           AllowsTransparency="True" Cursor="" >
        <!--обертка для прозрачности-->
        <Border Background="Transparent">
            <!--и дальше содержимое-->
            <Border Background="{StaticResource AppBackBrush}"
                    BorderBrush="{StaticResource SplitterBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="10">
                <StackPanel Orientation="Horizontal">
                    <local:CalendarControl x:Name="MyCalendar0"
                                           ParPop="{x:Reference SingleleCalendarPopup}"
                                           Margin="2 2 30 2"
                                           IsSingleMode="False"/>
                </StackPanel>
            </Border>
        </Border>
    </Popup>
    <!--==============================================================================================================-->
    <!--список №№-->
    <Popup x:Key="IdListPopup" Placement="Center" StaysOpen="False" >
        <Border Background="{StaticResource BackgroundBrush}"  BorderBrush="{StaticResource AppBackOverBrush}" BorderThickness="1" Padding="15" MaxWidth="600" CornerRadius="3">
            <TextBlock Name="IdListTextBlock" TextWrapping="Wrap" Background="Transparent" Foreground="{StaticResource MessageBrush}"/>
        </Border>
    </Popup>
