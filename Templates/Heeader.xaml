<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="HeaderBackColor">#000000</Color>
    <Color x:Key="HeaderBorderColor">#EAF2B9</Color>
    <Color x:Key="HeaderBackOverColor">#2580BF</Color>

    <SolidColorBrush x:Key="HeaderBackBrush" Color="{StaticResource HeaderBackColor}"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="{StaticResource HeaderBorderColor}" />
    <SolidColorBrush x:Key="HeaderBackOverBrush" Color="{StaticResource HeaderBackOverColor}" />

   

 <!-- Стиль для верхней панели -->
    <Style x:Key="HeaderStyle" TargetType="Border">
        <Setter Property="Height" Value="auto"/>
        <Setter Property="Background" Value="{StaticResource HeaderBackBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource HeaderBorderBrush}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>

    </Style>

    <FontFamily x:Key="LCDFont">pack://application:,,,/Fonts/#LCD5x8H</FontFamily>
    <!--<local:DateConverter x:Key = "DateConverter" />-->

    <!-- Стиль для текстБлоков -->
    <!--Равномерный по-вертикали только 25,17 размер шрифта-->
    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LCDFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="GreenYellow"/>
    </Style>
  

    <!-- Стили для кнопок заголовка -->

    <!-- Базовый Стиль для кнопок Заголовка -->
    <Style x:Key="HeaderButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{StaticResource HeaderBackBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="18"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                        BorderBrush="#FFCCCCCC" 
                        BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для кнопки Закрыть -->
    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border 
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="0,8,0,0">
                        <ContentPresenter 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFCC0000" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль для кнопки Развернуть -->
    <Style x:Key="MaxButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
       
        <Style.Triggers>
            <!-- Изменение фона при наведении -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#CCA91D"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль для кнопки Свернуть -->
    <Style x:Key="MinButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
        <Style.Triggers>
            <!-- Изменение фона при наведении -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3DA030"/>
            </Trigger>
        </Style.Triggers>
    </Style>



</ResourceDictionary>
