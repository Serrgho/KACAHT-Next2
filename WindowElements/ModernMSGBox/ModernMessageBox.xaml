<Window x:Class="Kas.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KACAHT_Next2.Kas"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        MinWidth="300"
        MaxWidth="500">
         
    <Border CornerRadius="10"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource TitleBrush}"
            BorderThickness="1"
            >
<!--Effect="{StaticResource ShadowEffect}"-->
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Title}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TitleBrush}"
                       Margin="0,0,0,10"/>

            <!-- Сообщение -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="300">
                
                <TextBlock Grid.Row="1"
                           Text="{Binding Message, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="#EEEEEE"
                           TextWrapping="Wrap"
                           Margin="10"
                           FontSize="18"/>
            </ScrollViewer>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0">
                <Button Content="ОК"
                        IsDefault="True"
                        Style="{StaticResource AccentButton}"
                        Click="OkButton_Click"
                        MinWidth="80"
                        FontSize="18"
                        Margin="2,2"/>

                <Button Content="Отмена"
                        Style="{StaticResource NormalButton}"
                        Click="CancelButton_Click"
                        IsCancel="True"
                        MinWidth="80"
                        
                        FontSize="18"
                        Margin="2,2"
                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisConverter}}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
