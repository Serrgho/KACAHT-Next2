<Window x:Class="Kas.IsSavedWin"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:KACAHT_Next2.Kas"
     SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    AllowsTransparency="True"
    WindowState="Normal"
    ResizeMode="NoResize"
    WindowStyle="None"
    Background="Transparent"
    ShowInTaskbar="False">
    <Border Background="{StaticResource AppBackBrush}" BorderThickness="2" BorderBrush="{StaticResource SplitterBrush}" CornerRadius="4" Width="350" >
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="За кем сохранен отказ?" 
               FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

            <StackPanel x:Name="RadioPanel" Grid.Row="1" MaxHeight="300" >

            </StackPanel>

            <Grid Grid.Row="2"   Margin="0,15,0,0">
                <Button Content="OK" Width="70" Height="25" Margin="5" IsDefault="True"  HorizontalAlignment="Left"/>
				 <!--Click="OkButton_Click"-->
                <Button Content="Отмена" Width="70" Height="25" Margin="5" IsCancel="True"  HorizontalAlignment="Right"/>
				  <!--Click="CancelButton_Click"-->
            </Grid>
        </Grid>
    </Border>
</Window>
