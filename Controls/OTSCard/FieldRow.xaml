<UserControl x:Class="Kas.FieldRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KACAHT_Next2.Kas">
    <Grid Margin="4 2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
            
        <TextBlock Grid.Column="0"  x:Name="TextField" FontWeight="Bold" Foreground="Black" />
        <TextBlock Grid.Column="1" x:Name="ValueField" Margin="8,0,0,0" TextWrapping="Wrap" Foreground="Black"/>
    </Grid>
</UserControl>
