<UserControl x:Class="Kas.HistoryEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d" 
             >

    <GroupBox Header="История изменений" FontWeight="SemiBold"  BorderBrush="#AAAAAA" Foreground="DarkGreen" Margin="0 0 0 10" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопки -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                <Button Content="➕" Padding="8,2" Click="BtnAdd_Click" Style="{StaticResource PopupStyleButton}" Foreground="DarkGreen"/>
                <Button Content="🗑" Padding="8,2" Click="BtnRemove_Click" x:Name="BtnDel" Style="{StaticResource PopupStyleButton}" Foreground="DarkRed"/>
            </StackPanel>

            <!-- Список с кнопками перемещения слева -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,5,0">
                    <Button Content="▲" Padding="8,2" FontSize="17" Click="BtnMoveUp_Click" x:Name="BtnUp" Style="{StaticResource PopupStyleButton}"/>
                    <Button Content="▼" Padding="8,2" FontSize="17" Click="BtnMoveDown_Click" x:Name="BtnDown" Style="{StaticResource PopupStyleButton}"/>
                </StackPanel>

                <ListBox Grid.Column="1" x:Name="LstHistory" Background="Transparent"
                         ItemsSource="{Binding HistoryEntries, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         SelectedItem="{Binding SelectedEntry, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="6,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Border"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True"
                                                Background="{TemplateBinding Background}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Дата (скрывается если ShowDate=False) -->
                                                <TextBlock x:Name="DateText"
                                                           Grid.Column="0"
                                                           Text="{Binding EventDate, StringFormat={}{0:dd.MM.yyyy}}"
                                                           MinWidth="70" Margin="0 0 15 0"
                                                           VerticalAlignment="Top"
                                                           FontWeight="Normal"/>
                                                <!-- Описание -->
                                                <TextBlock x:Name="DescText"
                                                           Grid.Column="1"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Stretch"
                                                           FontWeight="Normal"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- Скрыть дату если ShowDate=False -->
                                            <DataTrigger Binding="{Binding ShowDate}" Value="False">
                                                <Setter TargetName="DateText" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="DateText" Property="MinWidth" Value="0"/>
                                                <Setter TargetName="DateText" Property="Margin" Value="0"/>
                                            </DataTrigger>

                                            <!-- Выделение: фон + белый текст + жирный шрифт -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SplitterBrush}"/>
                                                <Setter TargetName="DateText" Property="Foreground" Value="White"/>
                                                <Setter TargetName="DescText" Property="Foreground" Value="White"/>
                                                <Setter TargetName="DateText" Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="DescText" Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            
                                            <!-- Наведение -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ScrolBarBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <!-- Редактор записей -->
            <StackPanel x:Name="EditorPanel" Grid.Row="2" Margin="0,5,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedEntry, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Редактор записей" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Black" Margin="0,0,0,5"/>
                
                
                
                
                <CheckBox x:Name="IsRedCBox" Content="Текст красным цветом"
                          IsChecked="{Binding SelectedEntry.IsRed, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="15 0"/>
                
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Чекбокс управления датой -->
                    <CheckBox x:Name="ShowDateCBox" 
                              IsChecked="{Binding SelectedEntry.ShowDate, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="15 0"/>
                    <TextBlock Grid.Column="1" Text="Дата" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="Black" Margin="0 0 15 0"/>
                    <!-- Датепикер (видимость зависит от чекбокса) -->
                    <DatePicker x:Name="DatePickerControl"
                                Grid.Column="2"
                                SelectedDate="{Binding SelectedEntry.EventDate, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                Visibility="{Binding IsChecked, ElementName=ShowDateCBox, Converter={StaticResource BoolToVisConverter}}"
                                Width="120"/>
                </Grid>
                <TextBox x:Name="TxtDescription" 
                         Text="{Binding SelectedEntry.Description, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                         
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40">
                    <TextBox.Style>
                        <!-- Указываем TargetType, чтобы Style знал, к чему применяться -->
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <!-- Добавляем путь к SelectedEntry, если IsRed лежит там -->
                                <DataTrigger Binding="{Binding SelectedEntry.IsRed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <!--<Setter Property="FontWeight" Value="Bold"/>-->
                                    <!-- Для наглядности теста -->
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>

                    </TextBox.Style>
                    
                </TextBox>
            </StackPanel>
        </Grid>
    </GroupBox>





   
</UserControl>
