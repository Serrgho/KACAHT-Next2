<UserControl x:Class="Kas.PoyasnilkaCTL"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d">
    <Expander x:Name="expPoyasnilka"
              Header="📝 Справки, Пояснилка"	  
              Background="{StaticResource ScrolBarBrush}"
              Foreground="DarkBlue"	  
              FontWeight="Bold"
              FontSize="15"
              BorderThickness="3"
              BorderBrush="{StaticResource SplitterBrush}"
              IsExpanded="True"
              d:IsExpanded="True"
              HorizontalContentAlignment="Stretch">
		<StackPanel>
            <Button x:Name="SelectPeriod" Foreground="DarkRed" Style="{StaticResource PopupStyleButton}" Click="SelectPeriod_Click" Visibility="Collapsed">Указать тек период</Button>
			<Button x:Name="SelectOldPeriod"  Style="{StaticResource PopupStyleButton}" Click="SelectPeriod_Click" Cursor="Hand" Tag="📆">Выбрать другой прошлый период (для ПОЯСНИЛКИ)</Button>
			<Button x:Name="ResetPeriod"  Style="{StaticResource PopupStyleButtonOrange}" Click="ResetPeriod_Click" Cursor="Hand" Tag="📆">Сбросить другой прошлый период (для ПОЯСНИЛКИ)</Button>
			<Button x:Name="BtnExport" Style="{StaticResource PopupStyleButtonGreen}" Click="BtnExport_Click" Tag="✏️📜">ПОЯСНИЛКА</Button>

			<WrapPanel Orientation="Horizontal" Background="{StaticResource ScrolBarBrush}" VerticalAlignment="Center" Margin="0 8 0 0">
				<Button  x:Name="btnS24Show" Content="Справка 24" Style="{StaticResource PopupStyleButtonGreen}" Tag="✏️📜" Margin="2" Click="btnS24Show_Click" Width="auto" />
				<Button  x:Name="btnS24T2Show" Content="Справка по комплексам" Style="{StaticResource PopupStyleButtonGreen}" Tag="✏️📜" Margin="2" Click="btnS24T2Show_Click" Width="auto" />
				<Button  x:Name="btnDailyShow" Content="Суточный отчет" Style="{StaticResource PopupStyleButtonGreen}" Tag="✏️📜" Margin="2" Click="btnDailyShow_Click" Width="auto" />
				<Button  x:Name="btnDailyPoyasnShow" Content="Утренняя пояснилка" Style="{StaticResource PopupStyleButtonGreen}" Tag="✏️📜" Click="btnDailyPoyasnShow_Click" Width="auto" />
			</WrapPanel>
		</StackPanel>
    </Expander>
</UserControl>
