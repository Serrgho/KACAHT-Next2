<UserControl x:Class="Kas.InfoLBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<Expander x:Name="expAuth" 
		  Header="Показать лог" 
		  Background="{StaticResource ScrolBarBrush}"
		  Foreground="DarkBlue"
		  FontWeight="Bold"
		  FontSize="15"
		  BorderThickness="3" 
		  BorderBrush="{StaticResource SplitterBrush}" 
		  IsExpanded="False" 
		  HorizontalContentAlignment="Stretch">

			<Border Background="{StaticResource AppBackBrush}" BorderThickness="0" BorderBrush="{StaticResource ScrolBarBrush}" Cursor="">
			<Grid >
				<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="auto"/>
			</Grid.RowDefinitions>
				<ListBox x:Name="InfoLB" Grid.Row="0" Background="Transparent" HorizontalContentAlignment="Stretch">
						<!-- Стиль для ListBoxItem -->
				<ListBox.ItemContainerStyle>
					<Style TargetType="ListBoxItem">
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="BorderThickness" Value="0"/>
						<Setter Property="BorderBrush" Value="Transparent"/>
						<Setter Property="Margin" Value="0 2 0 0"/>
						<Setter Property="HorizontalAlignment" Value="Stretch"/>
						<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
						<!-- Расстояние между строками = 2 -->
						<Setter Property="Padding" Value="0"/>
						<Setter Property="Focusable" Value="False"/>
						<!-- Отключаем фокус -->
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ListBoxItem">
									<ContentPresenter />
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</ListBox.ItemContainerStyle>
				<ListBox.Template>
					<ControlTemplate TargetType="ListBox">
						<Border Background="{TemplateBinding Background}"
												BorderThickness="0"
												BorderBrush="Transparent"
												Padding="{TemplateBinding Padding}">
							<ScrollViewer Focusable="false"
										  HorizontalScrollBarVisibility="Auto"
										  VerticalScrollBarVisibility="Auto" Cursor="">
								<ItemsPresenter /> 
							</ScrollViewer>	
						</Border> 
					</ControlTemplate>	 
				</ListBox.Template>	  
					<ListBox.Resources>
						<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />
						<!--Шаблон для List(Of String)-->
						<DataTemplate DataType="{x:Type sys:String}">
							<TextBlock Text="{Binding}"
										TextWrapping="Wrap"		
										TextAlignment="Left"  	   
										HorizontalAlignment="Left" 		 
										FontFamily="Segoe UI Emoji, Segoe UI, Tahoma"
										Margin="4,2"
										MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ViewportWidth, FallbackValue=400}" />
						</DataTemplate>	
						<!--Шаблон для Otkaz-->	
						<DataTemplate DataType="{x:Type local:Otkaz}"> 
							<local:OTSRowControl DataContext="{Binding}" />
						</DataTemplate>	 
					</ListBox.Resources>
				</ListBox>	
				<Button x:Name="ClearText" Grid.Row="1" Style="{StaticResource PopupStyleButton}" Click="ClearText_Click" Content="Очистка текста"/> 
			</Grid>	
		</Border>
	</Expander>	
</UserControl>
