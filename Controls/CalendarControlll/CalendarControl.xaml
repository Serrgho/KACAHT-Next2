<UserControl x:Class="Kas.CalendarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             Loaded="UserControl_Loaded"
             mc:Ignorable="d">

    <Border MaxWidth="300" Height="auto" Background="{StaticResource AppBackBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"  />
            </Grid.RowDefinitions>
            <!-- Заголовок -->

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="50"/>

                </Grid.ColumnDefinitions>

                <Border  Grid.Column="0" x:Name="PrevMNTArrow"
                
                Background="{StaticResource AppBackBrush}"
                BorderBrush="{StaticResource SplitterBrush}"
                BorderThickness="1"
                CornerRadius="12 0 0 0 "
                MouseDown="PrevMNTArrow_MouseDown"
                Padding="2">
                    <Path x:Name="ArrowLeft"
                  Grid.Column="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Fill="{StaticResource SplitterBrush}"
                  Data="M 0 0 L 4 4 L 8 0 Z" RenderTransformOrigin="0.5,0.5" Height="31" Stretch="Fill" Width="30"  >
                        <Path.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="90"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                </Border>

                <!-- Выбор месяца -->
                <ComboBox Grid.Column="1" x:Name="MonthSelector" 
                          Width="120"
                          Style="{StaticResource MyCombo}"
                          SelectionChanged="MonthSelector_SelectionChanged"/>

                <!-- Отображение года -->
                <ComboBox Grid.Column="2" x:Name="YearLabel"
                  Style="{StaticResource MyCombo}"
                  SelectionChanged="YearLabel_SelectionChanged"/>

                <Border Grid.Column="3"
                    x:Name="NextMNTArrow"
                    
                    Background="{StaticResource AppBackBrush}"
                    BorderBrush="{StaticResource SplitterBrush}"
                    BorderThickness="1"
                    CornerRadius="0 12 0 0"
                    MouseDown="NextMNTArrow_MouseDown"
                    Padding="2">
                    <Path x:Name="ArrowRight"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{StaticResource SplitterBrush}"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      RenderTransformOrigin="0.5,0.5" Height="31" Stretch="Fill" Width="30" >
                        <Path.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="270"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                </Border>
            </Grid>
            <!--MaxWidth="274" MaxHeight="218"-->
            <!-- Сетка дней -->
            <Border Grid.Row="1" Background="{StaticResource AppBackBrush}" BorderBrush="Black" BorderThickness="1 0 1 0">
                <UniformGrid  x:Name="DaysGrid" Rows="7" Columns="7"   >
                    <!-- Дни недели -->
                    <TextBlock Text="Пн" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="Вт" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="Ср" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="Чт" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="Пт" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="Сб" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="Вс" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </UniformGrid>
            </Border>


            <!-- Кнопка "Сегодня" -->
            <Border Grid.Row="2" Background="{StaticResource AppBackBrush}" BorderBrush="Black" BorderThickness="1 0 1 1">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- По умолчанию CornerRadius = 0 -->
                        <Setter Property="CornerRadius" Value="0"/>
                        <Style.Triggers>
                            <!-- Если IsSingleMode = False, применяем скругление -->
                            <DataTrigger Binding="{Binding IsSingleMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="CornerRadius" Value="0 0 12 12"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock  Grid.Column="0"
                        x:Name="TodayButton"
                        Text="Сегодня:... "
                        TextAlignment="Left"
                        Margin="3"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="Black"
                        Background="Transparent"
                        PreviewMouseDown="TodayButton_PreviewMouseDown"/>

                    <TextBlock  Grid.Column="1"
                        x:Name="SelecteddayButton"
                        Text="Выбрано:... "
                        TextAlignment="Right"
                        Margin="3"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="Black"
                        Background="Transparent" Cursor=""/>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Background="{StaticResource AppBackBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="29*"/>
                    <ColumnDefinition Width="121*"/>
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="OKButton"
                    Style="{StaticResource PopupStyleButtonWithVisibility}"
                    Click="OKButton_Click" Grid.ColumnSpan="2" Margin="5,5,5,5">
                    OK
                </Button>

            </Grid>
<!--Visibility="{Binding IsSingleMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"-->
        </Grid>
    </Border>
</UserControl>
