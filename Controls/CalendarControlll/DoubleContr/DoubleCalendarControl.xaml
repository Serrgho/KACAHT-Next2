<UserControl x:Class="Kas.DoubleCalendarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             Loaded="UserControl_Loaded"
             
             mc:Ignorable="d">

    <Popup Name="CalendarPopup"
           HorizontalOffset="0"
           VerticalOffset="3"
           PopupAnimation="Scroll"
           StaysOpen="False"
           Closed="CalendarPopup_Closed"
           PlacementTarget="{Binding}"
           Placement="Bottom"
            Opened="CalendarPopup_Opened"
           AllowsTransparency="True" Cursor="">
       
         <!--обертка для прозрачности-->
    <Border Background="Transparent">

        
        <Border 
          Background="{StaticResource AppBackBrush}"
          BorderBrush="{StaticResource SplitterBrush}"
          BorderThickness="4"
          CornerRadius="24"
          Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition  Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <local:CalendarControl x:Name="MyCalendar1" ParPop="{Binding ElementName=CalendarPopup}"  Margin="2 2 10 2" IsSingleMode="False"/>
                        <local:CalendarControl x:Name="MyCalendar2" ParPop="{Binding ElementName=CalendarPopup}" Margin="10 2 2 2" IsSingleMode="False"/>
                </StackPanel>
                <local:PeriodBlockControl Grid.Row="1" x:Name="PeriodBC"/>
                <Button x:Name="OKBU" Grid.Row="2" Style="{StaticResource PopupStyleButton}" Margin="3" Click="OKBU_Click"  >
                    OK
                </Button>
            </Grid>
        </Border>
    </Border>
        
    </Popup>
    
   
</UserControl>
