<UserControl x:Class="Kas.S24Table10"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

	<UserControl.Resources>
		<!-- Базовая рамка ячейки -->
		<Style x:Key="CellBorder" TargetType="Border">
			<Setter Property="BorderBrush" Value="Black"/>
			<Setter Property="BorderThickness" Value="0.5"/>
			<Setter Property="Background" Value="White"/>
		</Style>

		<!-- Рамка заголовка -->
		<Style x:Key="HeaderBorder" TargetType="Border" BasedOn="{StaticResource CellBorder}">
			<Setter Property="Background" Value="#FFEEEEEE"/>
		</Style>

		<!-- Рамка итоговой строки -->
		<Style x:Key="TotalBorder" TargetType="Border" BasedOn="{StaticResource CellBorder}">
			<Setter Property="Background" Value="#FFDDDDDD"/>
		</Style>

		<!-- Текст заголовка -->
		<Style x:Key="HeaderTextStyle" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="3,1"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="FontSize" Value="11"/>
		</Style>

		<!-- Текст ячейки данных -->
		<Style x:Key="CellStyle" TargetType="TextBlock">
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="3,1"/>
			<Setter Property="FontSize" Value="12"/>
		</Style>
	</UserControl.Resources>

	<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
		<!-- Общий заголовок отчета -->
		<TextBlock x:Name="LblCaption"
                   Width="Auto" MinWidth="300"
                   Text="Балловая оценка отказов 1 категории (сетевой учёт)"
                   TextWrapping="Wrap"
                   FontSize="16" FontWeight="Bold"
                   TextAlignment="Center" Margin="0,0,0,10"/>

		<!-- Основная сетка таблицы -->
		<Grid x:Name="MainGrid">

			<!-- !!! ВАЖНО: ОПРЕДЕЛЕНИЕ СТРОК !!! -->
			<!-- Row 0-2: Заголовки (фиксированная высота Auto) -->
			<!-- Row 3+: Данные (добавляются программно через RowDefinitions.Add) -->
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<!-- Периоды -->
				<RowDefinition Height="Auto"/>
				<!-- Т / СЛД / Всего -->
				<RowDefinition Height="Auto"/>
				<!-- Баллы / ОТС / Баллы -->
			</Grid.RowDefinitions>

			<!-- 
               Структура колонок (всего 13):
               0: Депо (120px)
               1: Тек. год - Т (Баллы=ОТС)
               2-3: Тек. год - СЛД (ОТС, Баллы)
               4: Тек. год - Всего баллов
               5-8: Прош. год весь (аналогично)
               9-12: Прош. год нараст. (аналогично)
            -->
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120"/>
				<!-- Депо -->

				<!-- Тек. год -->
				<ColumnDefinition Width="45"/>
				<!-- Т -->
				<ColumnDefinition Width="45"/>
				<!-- СЛД ОТС -->
				<ColumnDefinition Width="45"/>
				<!-- СЛД Баллы -->
				<ColumnDefinition Width="50"/>
				<!-- Всего -->

				<!-- Прош. год (весь период) -->
				<ColumnDefinition Width="45"/>
				<ColumnDefinition Width="45"/>
				<ColumnDefinition Width="45"/>
				<ColumnDefinition Width="50"/>

				<!-- Прош. год (с нач. года) -->
				<ColumnDefinition Width="45"/>
				<ColumnDefinition Width="45"/>
				<ColumnDefinition Width="45"/>
				<ColumnDefinition Width="50"/>
			</Grid.ColumnDefinitions>

			<!-- ===== ЗАГОЛОВКИ ===== -->

			<!-- Row 0: Названия периодов -->
			<Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Тек. год"/>
			</Border>
			<Border Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="4" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Прош. год&#x0a;(весь период)"/>
			</Border>
			<Border Grid.Row="0" Grid.Column="9" Grid.ColumnSpan="4" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Прош. год&#x0a;(с нач. года)"/>
			</Border>

			<!-- Row 1: Группы Т / СЛД / Всего -->
			<!-- Тек. год -->
			<Border Grid.Row="1" Grid.Column="1" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Т"/>
			</Border>
			<Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="СЛД"/>
			</Border>
			<!-- !!! ОБЪЕДИНЕНИЕ СТРОК ДЛЯ "ВСЕГО БАЛЛОВ" !!! -->
			<Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="4" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Всего&#x0a;баллов"/>
			</Border>

			<!-- Прош. год (весь период) -->
			<Border Grid.Row="1" Grid.Column="5" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Т"/>
			</Border>
			<Border Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="2" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="СЛД"/>
			</Border>
			<Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="8" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Всего&#x0a;баллов"/>
			</Border>

			<!-- Прош. год (с нач. года) -->
			<Border Grid.Row="1" Grid.Column="9" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Т"/>
			</Border>
			<Border Grid.Row="1" Grid.Column="10" Grid.ColumnSpan="2" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="СЛД"/>
			</Border>
			<Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="12" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Всего&#x0a;баллов"/>
			</Border>

			<!-- Row 2: Подзаголовки (только для Т и СЛД, т.к. "Всего" уже занял место) -->
			<!-- Тек. год -->
			<Border Grid.Row="2" Grid.Column="1" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Баллы"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="2" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="ОТС"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="3" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Баллы"/>
			</Border>
			<!-- Колонка 4 пропущена, т.к. занята объединенным Border'ом выше -->

			<!-- Прош. год (весь период) -->
			<Border Grid.Row="2" Grid.Column="5" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Баллы"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="6" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="ОТС"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="7" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Баллы"/>
			</Border>
			<!-- Колонка 8 пропущена -->

			<!-- Прош. год (с нач. года) -->
			<Border Grid.Row="2" Grid.Column="9" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Баллы"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="10" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="ОТС"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="11" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Баллы"/>
			</Border>
			<!-- Колонка 12 пропущена -->

			<!-- Колонка "Депо" объединяет все 3 строки заголовков -->
			<Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Депо / СЛД"/>
			</Border>

		</Grid>
	</StackPanel>
</UserControl>
