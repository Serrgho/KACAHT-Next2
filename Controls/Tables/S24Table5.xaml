<UserControl x:Class="Kas.S24Table5"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d" 
             d:DesignWidth="900">
	<UserControl.Resources>
		<Style x:Key="CellBorder" TargetType="Border">
			<Setter Property="BorderBrush" Value="Black"/>
			<Setter Property="BorderThickness" Value="0.5"/>
			<Setter Property="Background" Value="White"/>
		</Style>
		<Style x:Key="HeaderBorder" TargetType="Border" BasedOn="{StaticResource CellBorder}">
			<Setter Property="Background" Value="#FFEEEEEE"/>
		</Style>
		<Style x:Key="TotalBorder" TargetType="Border" BasedOn="{StaticResource CellBorder}">
			<Setter Property="Background" Value="#FFDDDDDD"/>
		</Style>
		<Style x:Key="HeaderTextStyle" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="3,1"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style x:Key="CellStyle" TargetType="TextBlock">
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="3,1"/>
			<!-- Добавлено: принудительное центрирование самого блока внутри Border -->
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		<Style x:Key="RowLabelStyle" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="5,1"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
	</UserControl.Resources>

	<!-- StackPanel сжимается по содержимому и центрируется -->
	<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

		<!-- Заголовок -->
		<TextBlock x:Name="LblCaption" 
                   Text="Потери поездо-часов за период из-за ОТС всех категорий"
                   FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10"/>

		<!-- Таблица данных -->
		<Grid x:Name="MainGrid">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120"/>
				<!-- Подписи строк -->
				<ColumnDefinition Width="120"/>
				<!-- Комплекс -->
				<ColumnDefinition Width="120"/>
				<!-- Т -->
				<ColumnDefinition Width="120"/>
				<!-- ТР -->
				<ColumnDefinition Width="120"/>
				<!-- ЛТС -->
				<ColumnDefinition Width="120"/>
				<!-- Заводы -->
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<!-- Шапка -->
				<RowDefinition Height="Auto"/>
				<!-- ТГ -->
				<RowDefinition Height="Auto"/>
				<!-- ПГ -->
				<RowDefinition Height="Auto"/>
				<!-- Разница -->
			</Grid.RowDefinitions>

			<!-- ШАПКА -->
			<!--<Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderBorder}">
				<TextBlock Text="" Style="{StaticResource HeaderTextStyle}"/>
			</Border>-->
			<Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HeaderBorder}">
				<TextBlock Text="Комплекс" Style="{StaticResource HeaderTextStyle}"/>
			</Border>
			<Border Grid.Row="0" Grid.Column="2" Style="{StaticResource HeaderBorder}">
				<TextBlock Text="Т" Style="{StaticResource HeaderTextStyle}"/>
			</Border>
			<Border Grid.Row="0" Grid.Column="3" Style="{StaticResource HeaderBorder}">
				<TextBlock Text="ТР" Style="{StaticResource HeaderTextStyle}"/>
			</Border>
			<Border Grid.Row="0" Grid.Column="4" Style="{StaticResource HeaderBorder}">
				<TextBlock Text="ЛТС" Style="{StaticResource HeaderTextStyle}"/>
			</Border>
			<Border Grid.Row="0" Grid.Column="5" Style="{StaticResource HeaderBorder}">
				<TextBlock Text="Заводы" Style="{StaticResource HeaderTextStyle}"/>
			</Border>

			<!-- СТРОКА 1: ТЕКУЩИЙ ГОД -->
			<!-- x:Name="LblCurYear" - сюда пишем "2026 год" -->
			<TextBlock x:Name="LblCurYear" 
           Grid.Row="1" Grid.Column="0" TextAlignment="Right" FontWeight="Bold"
           Style="{StaticResource RowLabelStyle}" />

			<Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R1C1" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R1C2" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="1" Grid.Column="3" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R1C3" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="1" Grid.Column="4" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R1C4" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="1" Grid.Column="5" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R1C5" Style="{StaticResource CellStyle}"/>
			</Border>

			<!-- СТРОКА 2: ПРОШЛЫЙ ГОД -->
			<!-- x:Name="LblPrevYear" - сюда пишем "2025 год" -->
			<TextBlock x:Name="LblPrevYear" 
           Grid.Row="2" Grid.Column="0" TextAlignment="Right" FontWeight="Bold"
           Style="{StaticResource RowLabelStyle}"/>

			<Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R2C1" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R2C2" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="3" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R2C3" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="4" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R2C4" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="5" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R2C5" Style="{StaticResource CellStyle}"/>
			</Border>

			<!-- ТЕКУЩИЙ ГОД --><!--
			<TextBlock Grid.Row="1" Grid.Column="0" Text="поездо-часы" Style="{StaticResource RowLabelStyle}"/>
			<Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R1C1" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R1C2" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="1" Grid.Column="3" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R1C3" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="1" Grid.Column="4" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R1C4" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="1" Grid.Column="5" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R1C5" Style="{StaticResource CellStyle}"/>
			</Border>

			--><!-- ПРОШЛЫЙ ГОД --><!--
			<TextBlock Grid.Row="2" Grid.Column="0" Text="поездо-часы" Style="{StaticResource RowLabelStyle}"/>
			<Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R2C1" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R2C2" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="3" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R2C3" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="4" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R2C4" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="2" Grid.Column="5" Style="{StaticResource CellBorder}">
				<TextBlock x:Name="R2C5" Style="{StaticResource CellStyle}"/>
			</Border>-->

			<!-- РАЗНИЦА -->
			<TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource RowLabelStyle}" FontWeight="Bold"/>
			<Border Grid.Row="3" Grid.Column="1" Style="{StaticResource TotalBorder}">
				<TextBlock x:Name="R3C1" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="3" Grid.Column="2" Style="{StaticResource TotalBorder}">
				<TextBlock x:Name="R3C2" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="3" Grid.Column="3" Style="{StaticResource TotalBorder}">
				<TextBlock x:Name="R3C3" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="3" Grid.Column="4" Style="{StaticResource TotalBorder}">
				<TextBlock x:Name="R3C4" Style="{StaticResource CellStyle}"/>
			</Border>
			<Border Grid.Row="3" Grid.Column="5" Style="{StaticResource TotalBorder}">
				<TextBlock x:Name="R3C5" Style="{StaticResource CellStyle}"/>
			</Border>

		</Grid>
	</StackPanel>

</UserControl>
