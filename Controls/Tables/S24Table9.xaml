<UserControl x:Class="Kas.S24Table9"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d">
	<UserControl.Resources>
		<Style x:Key="CellBorder" TargetType="Border">
			<Setter Property="BorderBrush" Value="Black"/>
			<Setter Property="BorderThickness" Value="0.5"/>
			<Setter Property="Background" Value="White"/>
		</Style>
		<Style x:Key="HeaderBorder" TargetType="Border" BasedOn="{StaticResource CellBorder}">
			<Setter Property="Background" Value="#FFEEEEEE"/>
		</Style>
		<Style x:Key="TotalBorder" TargetType="Border" BasedOn="{StaticResource CellBorder}">
			<Setter Property="Background" Value="#FFDDDDDD"/>
		</Style>
		<Style x:Key="HeaderTextStyle" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="3,1"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style x:Key="CellStyle" TargetType="TextBlock">
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="3,1"/>
		</Style>
	</UserControl.Resources>

	<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
		<TextBlock x:Name="LblCaption"
				Width="220"
                   Text="ОТС 1 категории (ТЧЭ/СЛД)"
				   TextWrapping="Wrap"
                   FontSize="16" FontWeight="Bold"
                   TextAlignment="Center" Margin="0,0,0,10"/>

		<Grid x:Name="MainGrid">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120"/>
				<ColumnDefinition Width="50"/>
				<ColumnDefinition Width="50"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Депо"/>
			</Border>
			<Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Т"/>
			</Border>
			<Border Grid.Row="0" Grid.Column="2" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="СЛД"/>
			</Border>
		</Grid>
	</StackPanel>
</UserControl>