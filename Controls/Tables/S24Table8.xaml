<UserControl x:Class="Kas.S24Table8"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d">
	<UserControl.Resources>
		<!-- Стили (если не глобальные, добавьте сюда или убедитесь в доступности) -->
		<Style x:Key="CellBorder" TargetType="Border">
			<Setter Property="BorderBrush" Value="Black"/>
			<Setter Property="BorderThickness" Value="0.5"/>
			<Setter Property="Background" Value="White"/>
		</Style>
		<Style x:Key="HeaderBorder" TargetType="Border" BasedOn="{StaticResource CellBorder}">
			<Setter Property="Background" Value="#FFEEEEEE"/>
		</Style>
		<Style x:Key="TotalBorder" TargetType="Border" BasedOn="{StaticResource CellBorder}">
			<Setter Property="Background" Value="#FFDDDDDD"/>
		</Style>
		<Style x:Key="HeaderTextStyle" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="3,1"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style x:Key="CellStyle" TargetType="TextBlock">
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="3,1"/>
		</Style>
	</UserControl.Resources>

	<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
		<!-- Заголовок -->
		<TextBlock x:Name="LblCaption" 
                   Text="Корректировки ОТС 1,2 категории" 
                   FontSize="16" FontWeight="Bold" 
                   TextAlignment="Center" Margin="0,0,0,10"/>

		<!-- Таблица -->
		<Grid x:Name="MainGrid">
			<Grid.ColumnDefinitions>
				
				<ColumnDefinition />
				<!-- в 3 кат -->
				<ColumnDefinition />
				<!-- в Т.Н. -->
				<ColumnDefinition />
				<!-- На др. дороги -->
				<ColumnDefinition />
				<!-- ИТОГО -->
			</Grid.ColumnDefinitions>

			<!-- Шапка -->
			<!--<Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="Депо"/>
			</Border>-->
			<Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="в 3 кат"/>
			</Border>
			<Border Grid.Row="0" Grid.Column="1" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="в Т.Н."/>
			</Border>
			<Border Grid.Row="0" Grid.Column="2" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="На др. дороги"/>
			</Border>
			<Border Grid.Row="0" Grid.Column="3" Style="{StaticResource HeaderBorder}">
				<TextBlock Style="{StaticResource HeaderTextStyle}" Text="ИТОГО"/>
			</Border>

			<!-- Данные будут добавлены программно -->
		</Grid>
	</StackPanel>
</UserControl>
