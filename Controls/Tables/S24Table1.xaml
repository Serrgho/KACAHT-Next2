             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d">
	<UserControl.Resources>
		<Style x:Key="CellBorder" TargetType="Border">
			<Setter Property="BorderBrush" Value="Black"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="White"/>
		</Style>
		<Style x:Key="HeaderBorder" TargetType="Border" BasedOn="{StaticResource CellBorder}">
			<Setter Property="Background" Value="#FFEEEEEE"/>
		</Style>
		<Style x:Key="HeaderTextStyle" TargetType="TextBlock">
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="4,2"/>
		</Style>
		<Style x:Key="CellStyle" TargetType="TextBlock">
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="4,2"/>
		</Style>
		<Style x:Key="GoalTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HeaderTextStyle}">
			<Setter Property="Foreground" Value="Red"/>
			<Setter Property="FontWeight" Value="Normal"/>
		</Style>
