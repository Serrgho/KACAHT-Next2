             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d">
	<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,15">
		<!-- Основной заголовок -->
		<TextBlock Text="АНАЛИЗ КАСАНТ" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   TextAlignment="Center"
                   Foreground="#FF000080"/>
		<!-- Темно-синий цвет как на скриншоте -->

		<!-- Дата -->
		<TextBlock x:Name="LblDate" 
                   Text="21 Августа 2026г." 
                   FontSize="16" 
                   FontWeight="Bold" 
                   TextAlignment="Center"
                   Margin="0,5,0,0"/>
	</StackPanel>
</UserControl>
