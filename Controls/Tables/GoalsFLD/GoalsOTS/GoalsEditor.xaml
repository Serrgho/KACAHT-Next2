<Window x:Class="Kas.GoalsEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KACAHT_Next2.Kas"
        mc:Ignorable="d"
		MinWidth="420"
        Title="Редактор целевых показателей" 
        WindowStartupLocation="CenterOwner"
		Background="{StaticResource AppBackBrush}"
		SizeToContent="WidthAndHeight">
	<Window.Resources>
		<local:ZeroToEmptyConverter x:Key="ZeroTextConverter"/>
		<Style x:Key="GoalTextBoxStyle" TargetType="TextBox">
			<Setter Property="Margin" Value="2"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="Width" Value="80"/>
			<Setter Property="Padding" Value="3,2"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="15" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="TextAlignment"  Value="Center" />
			<Setter Property="Background" Value="{ StaticResource ScrolBarBrush}"/>
			<EventSetter Event="PreviewMouseLeftButtonDown" Handler="TextBox_SelectAll_OnPreviewMouseLeftButtonDown"/>
			<EventSetter Event="GotKeyboardFocus" Handler="TextBox_GotKeyboardFocus"/>
		</Style>
	</Window.Resources>
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Выбор года и месяца -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
			<TextBlock Text="Год:" VerticalAlignment="Center" Margin="0,0,5,0"/>
			<ComboBox x:Name="CmbYear" Style="{StaticResource MyCombo}" Width="80" Margin="0,0,20,0"/>

			<TextBlock Text="Месяц:" VerticalAlignment="Center" Margin="0,0,5,0"/>
			<ComboBox x:Name="CmbMonth" Style="{StaticResource MyCombo}" Width="80"/>

			<Button x:Name="BtnLoad" Content="Перезагрузить" Click="BtnLoad_Click" Style="{StaticResource PopupStyleButton}" Margin="20,0,0,0" Width="110"/>
		</StackPanel>

		<!-- Таблица ввода -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="100"/>
				<ColumnDefinition Width="100"/>
				<ColumnDefinition Width="100"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			
			<!-- Заголовки -->
			<TextBlock Grid.Row="0" Grid.Column="0" Text="Группа" FontWeight="Bold" Padding="5"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="1+2 кат" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="3 кат" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>
			<TextBlock Grid.Row="0" Grid.Column="3" Text="1-3 кат" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>

			<!-- Комплекс (вычисляемое) -->
			<TextBlock Grid.Row="1" Grid.Column="0" Text="Комплекс" VerticalAlignment="Center" Padding="5" FontWeight="Bold"/>
			<TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Complex12}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5" />
			<TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Complex3}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5" />
			<TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Complex13}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5" />

			<!-- Т -->
			<TextBlock Grid.Row="2" Grid.Column="0" Text="Т" VerticalAlignment="Center" Padding="5"/>

			<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding T12, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="2" Grid.Column="2" Text="{Binding T3, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding T13}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

			<!-- ТР -->
			<TextBlock Grid.Row="3" Grid.Column="0" Text="ТР" VerticalAlignment="Center" Padding="5"/>
			<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TR12, Converter={StaticResource ZeroTextConverter},UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="3" Grid.Column="2" Text="{Binding TR3, Converter={StaticResource ZeroTextConverter},UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding TR13}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

			<!-- СЛД -->
			<TextBlock Grid.Row="4" Grid.Column="0" Text="СЛД" VerticalAlignment="Center" Padding="5"/>
			<TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SLD12, Converter={StaticResource ZeroTextConverter},UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="4" Grid.Column="2" Text="{Binding SLD3, Converter={StaticResource ZeroTextConverter},UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding SLD13}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

			<!-- Заводы -->
			<TextBlock Grid.Row="5" Grid.Column="0" Text="Заводы" VerticalAlignment="Center" Padding="5"/>
			<TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Factory12, Converter={StaticResource ZeroTextConverter},UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Factory3, Converter={StaticResource ZeroTextConverter},UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding Factory13}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

			<TextBlock Grid.Row="6" Grid.Column="0" Text="Суточное пороговое кол-во" VerticalAlignment="Center" TextAlignment="Center" Padding="5"/>
			<TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DailyThreshold, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GoalTextBoxStyle}" Width="180" HorizontalAlignment="Left" Margin="10,3,0,0"/>
		</Grid>

		<!-- Кнопки -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
			<Button Name="BtnClearAll" Content="Очистить всё" Style="{StaticResource PopupStyleButton}" Click="BtnClearAll_Click" Margin="0,0,10,0"/>
			<Button Content="Сохранить" Click="BtnSave_Click" Style="{StaticResource PopupStyleButton}" Width="100" Margin="0,0,10,0" IsDefault="True"/>
		</StackPanel>
	</Grid>
</Window>
