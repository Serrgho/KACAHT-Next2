<UserControl x:Class="Kas.GoalHoursEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d"
             MinWidth="640"
             Background="{StaticResource AppBackBrush}">
	<UserControl.Resources>
		<local:ZeroToEmptyConverterSng x:Key="ZeroTextConverter"/>
		<Style x:Key="GoalTextBoxStyle" TargetType="TextBox">
			<Setter Property="Margin" Value="2"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="Width" Value="80"/>
			<Setter Property="Padding" Value="3,2"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="Background" Value="{StaticResource ScrolBarBrush}"/>
			<EventSetter Event="PreviewMouseLeftButtonDown" Handler="TextBox_SelectAll_OnPreviewMouseLeftButtonDown"/>
			<EventSetter Event="GotKeyboardFocus" Handler="TextBox_GotKeyboardFocus"/>
		</Style>
	</UserControl.Resources>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Выбор года и месяца -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
			<TextBlock Text="Год:" VerticalAlignment="Center" Margin="0,0,5,0"/>
			<ComboBox x:Name="CmbYear" Style="{StaticResource MyCombo}" Width="80" Margin="0,0,20,0"/>

			<TextBlock Text="Месяц:" VerticalAlignment="Center" Margin="0,0,5,0"/>
			<ComboBox x:Name="CmbMonth" Style="{StaticResource MyCombo}" Width="80"/>

			<Button x:Name="BtnLoad" Content="Перезагрузить" Click="BtnLoad_Click"
					Style="{StaticResource PopupStyleButton}" Margin="20,0,0,0" Width="110"/>
			<Button Name="BtnPaste" Content="Вставить из буфера" Style="{StaticResource PopupStyleButtonGreen}"
		Click="BtnPaste_Click"  Margin="100,0,2,0"/>
		</StackPanel>

		<!-- Таблица ввода: 7 строк × 6 колонок -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="90"/>
				<ColumnDefinition Width="90"/>
				<ColumnDefinition Width="90"/>
				<ColumnDefinition Width="90"/>
				<ColumnDefinition Width="90"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<!-- 0: заголовки -->
				<RowDefinition Height="Auto"/>
				<!-- 1: Боготол (k=1) -->
				<RowDefinition Height="Auto"/>
				<!-- 2: Красноярск (k=2) -->
				<RowDefinition Height="Auto"/>
				<!-- 3: Иланская (k=3) -->
				<RowDefinition Height="Auto"/>
				<!-- 4: Ачинск (k=5) -->
				<RowDefinition Height="Auto"/>
				<!-- 5: Абакан (k=7) -->
				<RowDefinition Height="Auto"/>
				<!-- 6: Всего -->
			</Grid.RowDefinitions>

			<!-- Заголовки -->
			<TextBlock Grid.Row="0" Grid.Column="0" Text="Депо" FontWeight="Bold" Padding="5"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="ТЧЭ" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="СЛД" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>
			<TextBlock Grid.Row="0" Grid.Column="3" Text="Заводы" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>
			<TextBlock Grid.Row="0" Grid.Column="4" Text="ТР" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>
			<TextBlock Grid.Row="0" Grid.Column="5" Text="Всего" FontWeight="Bold" HorizontalAlignment="Center" Padding="5"/>

			<!-- Боготол (k=1) -->
			<TextBlock Grid.Row="1" Grid.Column="0" Text="Боготол" VerticalAlignment="Center" Padding="5"/>
			<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding D1Tche, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="1" Grid.Column="2" Text="{Binding D1Sld, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="1" Grid.Column="3" Text="{Binding D1Zav, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="1" Grid.Column="4" Text="{Binding D1Tr, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding D1All, StringFormat=F2, ConverterCulture=ru-RU}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

			<!-- Красноярск (k=2) -->
			<TextBlock Grid.Row="2" Grid.Column="0" Text="Красноярск" VerticalAlignment="Center" Padding="5"/>
			<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding D2Tche, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="2" Grid.Column="2" Text="{Binding D2Sld, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="2" Grid.Column="3" Text="{Binding D2Zav, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="2" Grid.Column="4" Text="{Binding D2Tr, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding D2All, StringFormat=F2, ConverterCulture=ru-RU}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

			<!-- Иланская (k=3) -->
			<TextBlock Grid.Row="3" Grid.Column="0" Text="Иланская" VerticalAlignment="Center" Padding="5"/>
			<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding D3Tche, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="3" Grid.Column="2" Text="{Binding D3Sld, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="3" Grid.Column="3" Text="{Binding D3Zav, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="3" Grid.Column="4" Text="{Binding D3Tr, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBlock Grid.Row="3" Grid.Column="5" Text="{Binding D3All, StringFormat=F2, ConverterCulture=ru-RU}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

			<!-- Ачинск (k=5) -->
			<TextBlock Grid.Row="4" Grid.Column="0" Text="Ачинск" VerticalAlignment="Center" Padding="5"/>
			<TextBox Grid.Row="4" Grid.Column="1" Text="{Binding D5Tche, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="4" Grid.Column="2" Text="{Binding D5Sld, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="4" Grid.Column="3" Text="{Binding D5Zav, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="4" Grid.Column="4" Text="{Binding D5Tr, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBlock Grid.Row="4" Grid.Column="5" Text="{Binding D5All, StringFormat=F2, ConverterCulture=ru-RU}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

			<!-- Абакан (k=7) -->
			<TextBlock Grid.Row="5" Grid.Column="0" Text="Абакан" VerticalAlignment="Center" Padding="5"/>
			<TextBox Grid.Row="5" Grid.Column="1" Text="{Binding D7Tche, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="5" Grid.Column="2" Text="{Binding D7Sld, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="5" Grid.Column="3" Text="{Binding D7Zav, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBox Grid.Row="5" Grid.Column="4" Text="{Binding D7Tr, Converter={StaticResource ZeroTextConverter}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource GoalTextBoxStyle}"/>
			<TextBlock Grid.Row="5" Grid.Column="5" Text="{Binding D7All, StringFormat=F2, ConverterCulture=ru-RU}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>

			<!-- Всего (вычисляемое всё) -->
			<TextBlock Grid.Row="6" Grid.Column="0" Text="Всего" FontWeight="Bold" VerticalAlignment="Center" Padding="5"/>
			<TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TotalTche, StringFormat=F2, ConverterCulture=ru-RU}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5" FontWeight="Bold"/>
			<TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding TotalSld, StringFormat=F2, ConverterCulture=ru-RU}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5" FontWeight="Bold"/>
			<TextBlock Grid.Row="6" Grid.Column="3" Text="{Binding TotalZav, StringFormat=F2, ConverterCulture=ru-RU}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5" FontWeight="Bold"/>
			<TextBlock Grid.Row="6" Grid.Column="4" Text="{Binding TotalTr, StringFormat=F2, ConverterCulture=ru-RU}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5" FontWeight="Bold"/>
			<TextBlock Grid.Row="6" Grid.Column="5" Text="{Binding TotalAll, StringFormat=F2, ConverterCulture=ru-RU}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5" FontWeight="Bold"/>
		</Grid>

		<!-- Кнопки -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
			<Button Name="BtnClearAll" Content="Очистить всё" Style="{StaticResource PopupStyleButton}" Click="BtnClearAll_Click" Margin="0,0,10,0"/>
			<Button Content="Сохранить" Click="BtnSave_Click" Style="{StaticResource PopupStyleButton}" Width="100" Margin="0,0,10,0" IsDefault="True"/>
		</StackPanel>
	</Grid>
</UserControl>
