<UserControl x:Class="Kas.MainDataCTL"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
			 
             mc:Ignorable="d">

	<Expander x:Name="expDataWork" Background="{StaticResource ScrolBarBrush}" Foreground="DarkBlue" FontWeight="Bold"	FontSize="15" BorderThickness="3" BorderBrush="{StaticResource SplitterBrush}" IsExpanded="True" HorizontalContentAlignment="Stretch">

		<!-- Кастомный заголовок -->
		<Expander.Header>
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<!-- Основной текст заголовка -->
				<TextBlock Text="🌐📁📝  Работа с данными" Foreground="DarkBlue" FontWeight="Bold" FontSize="15"/>
				<!-- Разделитель (изначально скрыт) -->
				<TextBlock x:Name="TxtSeparator" Text=" | " Foreground="Gray" Visibility="Collapsed" Margin="20 0 0 0"/>
				<!-- Индикатор процесса (изначально пустой) -->
				<TextBlock x:Name="LblProcessStatus" Text="" Foreground="Red" FontWeight="Normal" FontSize="14" Padding="3 1" VerticalAlignment="Center"/>
			</StackPanel>
		</Expander.Header>

		<StackPanel>
			<Button x:Name="BtnShowInExplorer" Style="{StaticResource PopupStyleButton}" Click="BtnShowInExplorer_Click" Tag="📁" Content="Показать папку с данными"/>
			<Button x:Name="ResetToOTSList" Style="{StaticResource PopupStyleButtonOrange}" Click="ResetToOTSList_Click"  MouseEnter="ResetToOTSList_MouseEnter" MouseLeave="ResetToOTSList_MouseLeave" Tag="🕓" Content="Последний загруженный файл"/>
			<Button x:Name="FilterUnsigned" Style="{StaticResource PopupStyleButtonGreen}" Click="FilterUnsigned_Click" Tag="⚠️" Content="Не подписанные электронные протоколы"/>

			<WrapPanel x:Name="TopRibbon"  Orientation="Horizontal" Background="{StaticResource ScrolBarBrush}" VerticalAlignment="Center" Margin="0 8 0 0">
				<Button x:Name="LoadData" Style="{StaticResource PopupStyleButton}" Tag="📩" Content="Импорт из Excel" Click="LoadData_Click"/>
				<Button x:Name="LoadDataFromJSON" Style="{StaticResource PopupStyleButton}" Tag="📩" Content="Импорт из JSON" Click="LoadDataFromJSON_Click"/>
				<Button x:Name="BtnAddFromJRNL"  Style="{StaticResource PopupStyleButtonGreen}"  Click="BtnAddFromJRNL_Click" Tag="🛜" Content="Синхр. список ОТС"/>
				<Button x:Name="AppendDataToJSON" Style="{StaticResource PopupStyleButton}" Click="AppendDataToJSON_Click" Tag="💾++" Content="Добавить ОТС к файлу JSON"/>

				<Button x:Name="SaveDataToJSON"  Style="{StaticResource PopupStyleButton}" Click="SaveDataToJSON_Click" Tag="💾" Content=" Сохранить данные в JSON"/>
			</WrapPanel>
		</StackPanel>


		

    </Expander>
</UserControl>
