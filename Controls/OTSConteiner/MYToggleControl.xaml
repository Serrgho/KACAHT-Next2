<UserControl x:Class="Kas.MYToggleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
		<Style x:Key="CustomToggleStyle" TargetType="ToggleButton">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Grid Margin="2">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="15"/>
							</Grid.RowDefinitions>

							<Border x:Name="Bordr"
                                    Grid.Row="0"
                                    CornerRadius="5"
                                    Background="{DynamicResource SplitterBrush}"
                                    Width="35"
                                    Height="13"/>

							<Ellipse x:Name="Thumb"
                                     Grid.Row="0"
                                     Stroke="#BDBDBD"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Margin="2" 
                                     Width="22"
                                     Height="19">
								<!-- ЯВНОЕ ОБЪЯВЛЕНИЕ КИСТИ СПАСАЕТ ОТ OШИБКИ UNSETVALUE -->
								<Ellipse.Fill>
									<SolidColorBrush x:Name="ThumbBrush" Color="#BDBDBD"/>
								</Ellipse.Fill>
								<Ellipse.RenderTransform>
									<TranslateTransform x:Name="ThumbTransform" X="-12"/>
								</Ellipse.RenderTransform>
							</Ellipse>

							<TextBlock x:Name="OnText"
                                       Grid.Row="1"
                                       Text="вкл"
                                       Foreground="Green"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="2"
                                       Opacity="0"/>

							<TextBlock x:Name="OffText"
                                       Grid.Row="1"
                                       Text="выкл"
                                       Foreground="red"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="2"
                                       Opacity="1"/>
						</Grid>

						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<!-- УБРАЛИ КОНФЛИКТНЫЕ СЕТТЕРЫ ЦВЕТА И ПОЛОЖЕНИЯ. ОСТАВЛЯЕМ ТОЛЬКО ПЛАВНЫЕ АНИМАЦИИ -->
								<Trigger.EnterActions>
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation Storyboard.TargetName="ThumbTransform" 
                                                             Storyboard.TargetProperty="X"
                                                             To="12" Duration="0:0:0.2">
												<DoubleAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseInOut"/>
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>

											<ColorAnimation Storyboard.TargetName="Thumb"
                                                            Storyboard.TargetProperty="Fill.Color"
                                                            To="Green" Duration="0:0:0.4">
												<ColorAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseInOut"/>
												</ColorAnimation.EasingFunction>
											</ColorAnimation>

											<DoubleAnimation Storyboard.TargetName="OnText"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.3">
												<DoubleAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseInOut"/>
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>

											<DoubleAnimation Storyboard.TargetName="OffText"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.3">
												<DoubleAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseInOut"/>
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>
									</BeginStoryboard>
								</Trigger.EnterActions>

								<Trigger.ExitActions>
									<BeginStoryboard>
										<Storyboard>
											<DoubleAnimation Storyboard.TargetName="ThumbTransform" 
                                                             Storyboard.TargetProperty="X"
                                                             To="-12" Duration="0:0:0.2">
												<DoubleAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseInOut"/>
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>

											<ColorAnimation Storyboard.TargetName="Thumb"
                                                            Storyboard.TargetProperty="Fill.Color"
                                                            To="#BDBDBD" Duration="0:0:0.4">
												<ColorAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseInOut"/>
												</ColorAnimation.EasingFunction>
											</ColorAnimation>

											<DoubleAnimation Storyboard.TargetName="OnText"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.3">
												<DoubleAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseInOut"/>
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>

											<DoubleAnimation Storyboard.TargetName="OffText"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.3">
												<DoubleAnimation.EasingFunction>
													<QuadraticEase EasingMode="EaseInOut"/>
												</DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard>
									</BeginStoryboard>
								</Trigger.ExitActions>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="80">
		<TextBlock x:Name="Zagolovok"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"/>

		<ToggleButton Style="{StaticResource CustomToggleStyle}"
                      Name="MYToggle"
                      IsChecked="{Binding IsChecked, ElementName=RootControl, Mode=TwoWay}"
                      Checked="MYToggle_Checked"
                      Unchecked="MYToggle_Unchecked"/>
	</StackPanel>
</UserControl>
