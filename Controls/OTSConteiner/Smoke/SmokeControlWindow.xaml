<Window x:Class="Kas.SmokeControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KACAHT_Next2.Kas"
        mc:Ignorable="d"
		Closing="Window_Closing"
        Title="Smoke Simulation Engine - Панель управления" 
        Width="900" Height="650" 
        Background="{StaticResource AppBackBrush}"
        WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<!-- ЕДИНЫЙ СТИЛЬ ПАНЕЛИ УПРАВЛЕНИЯ -->
		<Style TargetType="TextBlock">
			<Setter Property="Background" Value="{StaticResource AppBackBrush}"/>
			<Setter Property="Foreground" Value="Black"/>
		</Style>
		<Style TargetType="Slider">
			<Setter Property="Background" Value="{StaticResource AppBackBrush}"/>
		</Style>
		<Style TargetType="Button">
			<Setter Property="Background" Value="{StaticResource AppBackBrush}"/>
			<Setter Property="Foreground" Value="Black"/>
		</Style>
		<Style TargetType="StackPanel">
			<Setter Property="Background" Value="{StaticResource AppBackBrush}"/>
		</Style>
	</Window.Resources>
	
	<Grid>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="280"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
	 	<!-- Левая панель управления -->
		<DockPanel Grid.Column="0" Margin="5" >
			<!-- КНОПКИ ВНИЗУ — всегда видны, вне скролла -->
			<StackPanel DockPanel.Dock="Bottom">
				<Separator Margin="0,15,0,15" Background="DimGray"/>
				<Button x:Name="BtnToggle" Content="Остановить дым" Height="30" Margin="0,5,0,5"/>
				<Button x:Name="BtnClear" Content="Очистить экран" Height="30" Margin="0,5,0,5"/>
				<Button x:Name="BtnSaveParams" Content="Сохранить параметры" Height="30" Margin="0,5,0,5" FontWeight="Bold"/>
			</StackPanel>

			<ScrollViewer  VerticalScrollBarVisibility="Auto" Padding="7">
				<ScrollViewer.Resources>
					<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />
				</ScrollViewer.Resources>

				<StackPanel Orientation="Vertical">

					<TextBlock Text="ПАРАМЕТРЫ ФИЗИКИ" FontSize="14" FontWeight="Bold" 
                        Margin="0,0,0,20" HorizontalAlignment="Center"/>

					<!-- ===== ДЫМ ===== -->
					<TextBlock x:Name="TxtSpeed" Tag="Скорость подъема" Text="Скорость подъема (2)"/>
					<Slider x:Name="SldSpeed" Tag="SmokeUpSpeed" Minimum="1" Maximum="80" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtFade" Tag="Время жизни" Text="Время жизни (0.995)"/>
					<Slider x:Name="SldFade" Tag="SmokeFadeRatio" Minimum="0.930" Maximum="0.995" Value="0.995" TickFrequency="0.001" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtWobble" Tag="Амплитуда покачивания" Text="Амплитуда покачивания (2.0)"/>
					<Slider x:Name="SldWobble" Tag="SmokeWobbleForce" Minimum="0" Maximum="30" Value="2" TickFrequency="0.1" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtVisc" Tag="Вязкость газа" Text="Вязкость газа (0.000)"/>
					<Slider x:Name="SldVisc" Tag="Visc" Minimum="0" Maximum="0.1" Value="0" TickFrequency="0.005" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtDens" Tag="Густота дыма" Text="Густота дыма (1.8)"/>
					<Slider x:Name="SldDens" Tag="SmokeDensity" Minimum="0.2" Maximum="10" Value="1.8" TickFrequency="0.1" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtPulse" Tag="Разделение потока" Text="Разделение потока (1)"/>
					<Slider x:Name="SldPulse" Tag="SmokePulseInterval" Minimum="1" Maximum="5" Value="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtColor" Tag="Цвет источника" Text="Цвет источника (223°)"/>
					<Slider x:Name="SldColor" Tag="SmokeHue" Minimum="0" Maximum="360" Value="223" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<!-- ===== МЫШЬ ===== -->
					<Separator Margin="0,15,0,15" Background="DimGray"/>
					<TextBlock Text="МЫШЬ" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

					<TextBlock x:Name="TxtMouseForce" Tag="Сила выстрела мыши" Text="Сила выстрела мыши (100.0)"/>
					<Slider x:Name="SldMouseForce" Tag="SmokeMouseForce" Minimum="0" Maximum="150" Value="100" TickFrequency="0.5" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtMouseAngle" Tag="Направление выстрела" Text="Направление выстрела (90°)"/>
					<Slider x:Name="SldMouseAngle" Tag="SmokeMouseAngle" Minimum="0" Maximum="360" Value="90" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<!-- ===== СРЕДА ===== -->
					<Separator Margin="0,15,0,15" Background="DimGray"/>
					<TextBlock Text="СРЕДА" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

					<TextBlock x:Name="TxtBuoyancy" Tag="Плавучесть" Text="Плавучесть (1.5)"/>
					<Slider x:Name="SldBuoyancy" Tag="SmokeBuoyancy" Minimum="0" Maximum="8" Value="1.5" TickFrequency="0.1" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtFriction" Tag="Трение воздуха" Text="Трение воздуха (0.975)"/>
					<Slider x:Name="SldFriction" Tag="AirFriction" Minimum="0.940" Maximum="0.999" Value="0.975" TickFrequency="0.001" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtCeilRows" Tag="Гашение плавучести у потолка, рядов" Text="Гашение плавучести у потолка (8)"/>
					<Slider x:Name="SldCeilRows" Tag="BuoyancyCeilingRows" Minimum="1" Maximum="30" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtCeil" Tag="Потолок: 0=отскок, 1=вытяжка" Text="Потолок: отскок/вытяжка (0.08)"/>
					<Slider x:Name="SldCeil" Tag="CeilingAbsorb" Minimum="0" Maximum="1" Value="0.08" TickFrequency="0.01" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<!-- ===== ВИЗУАЛ ===== -->
					<Separator Margin="0,15,0,15" Background="DimGray"/>
					<TextBlock Text="ВИЗУАЛ" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

					<TextBlock x:Name="TxtContrast" Tag="Чёткость струек" Text="Чёткость струек (200)"/>
					<Slider x:Name="SldContrast" Tag="SmokeContrast" Minimum="50" Maximum="500" Value="200" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtVorticity" Tag="Кудрявость" Text="Кудрявость (3.0)"/>
					<Slider x:Name="SldVorticity" Tag="SmokeVorticity" Minimum="0" Maximum="10" Value="3" TickFrequency="0.1" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtMouseContrast" Tag="Контраст мышиного дыма" Text="Контраст мышиного дыма (300)"/>
					<Slider x:Name="SldMouseContrast" Tag="MouseContrast" Minimum="50" Maximum="500" Value="300" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtAgeReveal" Tag="Кадров «детства» дыма" Text="Кадров «детства» дыма (8)"/>
					<Slider x:Name="SldAgeReveal" Tag="SmokeAgeReveal" Minimum="1" Maximum="30" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtGrayLevel" Tag="Яркость серого (0=чёрный, 1=белый)" Text="Яркость серого (0.28)"/>
					<Slider x:Name="SldGrayLevel" Tag="SmokeGrayLevel" Minimum="0" Maximum="1" Value="0.28" TickFrequency="0.01" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtUseGray" Tag="Серый дым (1=да, 0=цветной)" Text="Серый дым (1=да, 0=цветной)"/>
					<Slider x:Name="SldUseGray" Tag="SmokeUseGray" Minimum="0" Maximum="1" Value="1" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<!-- ===== ФИЗИКА ===== -->
					<Separator Margin="0,15,0,15" Background="DimGray"/>
					<TextBlock Text="ФИЗИКА" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

					<TextBlock x:Name="TxtDiff" Tag="Диффузия (мыло!)" Text="Диффузия — мыло (0.000)"/>
					<Slider x:Name="SldDiff" Tag="Diff" Minimum="0" Maximum="0.2" Value="0" TickFrequency="0.005" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtSimDt" Tag="Скорость симуляции" Text="Скорость симуляции (0.040)"/>
					<Slider x:Name="SldSimDt" Tag="SimDt" Minimum="0.01" Maximum="0.1" Value="0.04" TickFrequency="0.005" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtPressure" Tag="Итерации давления" Text="Итерации давления (10)"/>
					<Slider x:Name="SldPressure" Tag="PressureIterations" Minimum="1" Maximum="30" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<!-- ===== ИСТОЧНИК ===== -->
					<Separator Margin="0,15,0,15" Background="DimGray"/>
					<TextBlock Text="ИСТОЧНИК" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

					<TextBlock x:Name="TxtSrcRadius" Tag="Радиус разброса точек" Text="Радиус разброса точек (8)"/>
					<Slider x:Name="SldSrcRadius" Tag="SmokeSourceRadius" Minimum="1" Maximum="20" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtSrcPoints" Tag="Точек за импульс" Text="Точек за импульс (30)"/>
					<Slider x:Name="SldSrcPoints" Tag="SmokeSourcePoints" Minimum="1" Maximum="60" Value="30" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtTurb" Tag="Дрожь источника" Text="Дрожь источника (0.0)"/>
					<Slider x:Name="SldTurb" Tag="SmokeTurbulence" Minimum="0" Maximum="10" Value="0" TickFrequency="0.5" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<!-- ===== ПОРЫВЫ И КОЛЕЧКИ ===== -->
					<Separator Margin="0,15,0,15" Background="DimGray"/>
					<TextBlock Text="ПОРЫВЫ И КОЛЕЧКИ" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

					<TextBlock x:Name="TxtGust" Tag="Сила порывов" Text="Сила порывов (5.0)"/>
					<Slider x:Name="SldGust" Tag="GustPeakBase" Minimum="0" Maximum="15" Value="5" TickFrequency="0.5" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtGustChance" Tag="Частота порывов" Text="Частота порывов (0.015)"/>
					<Slider x:Name="SldGustChance" Tag="GustChance" Minimum="0" Maximum="0.05" Value="0.015" TickFrequency="0.001" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtRing" Tag="Сила колец" Text="Сила колец (120)"/>
					<Slider x:Name="SldRing" Tag="RingStrength" Minimum="0" Maximum="400" Value="120" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

					<TextBlock x:Name="TxtRingChance" Tag="Частота колец" Text="Частота колец (0.020)"/>
					<Slider x:Name="SldRingChance" Tag="RingChance" Minimum="0" Maximum="0.1" Value="0.02" TickFrequency="0.005" Margin="0,0,0,10" ValueChanged="SldGeneric_ValueChanged"/>

				</StackPanel>
			</ScrollViewer>
		</DockPanel>
		
		<local:SmokeCanvas x:Name="MySmokeCanvas" Grid.Column="1"
		SmokeUseGray="True"  SmokeGrayLevel="0.28"
		SmokeDensity="100"   SmokeUpSpeed="2"     SmokeFadeRatio="0.995"
		Visc="0"             Diff="0"             SimDt="0.04"
		AirFriction="0.975"  SmokeBuoyancy="1.5"  BuoyancyCeilingRows="8"
		SmokeVorticity="3"   PressureIterations="10"
		SmokeContrast="200"  MouseContrast="300"  SmokeAgeReveal="8"  CeilingAbsorb="0.08"
		SmokeSourceRadius="8" SmokeSourcePoints="30" SmokeTurbulence="0"
		SmokeWobbleForce="2" GustPeakBase="5"     GustChance="0.015"
		RingStrength="120"   RingChance="0.02"  />

	</Grid>
</Window>
