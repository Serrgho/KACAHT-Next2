<UserControl x:Class="Kas.FiltrBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d"
             SnapsToDevicePixels="True">

    <!-- Стиль для ВНУТРЕННЕГО Border -->
    <UserControl.Resources>
        <Style x:Key="InnerBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource SplitterBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect 
                                ShadowDepth="1" 
                                BlurRadius="6" 
                                Opacity="0.35" 
                                Color="#402060C0"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent" ClipToBounds="True">
        <Border Style="{StaticResource InnerBorderStyle}">
            <ContentPresenter VerticalAlignment="Center"/>
        </Border>
    </Grid>

</UserControl>
