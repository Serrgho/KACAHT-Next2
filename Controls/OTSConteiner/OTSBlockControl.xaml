			<Grid Grid.Row="3" ShowGridLines="True">
				<ScrollViewer x:Name="ScrollOTSBlockCont"
						  Grid.Row="1"
						  HorizontalScrollBarVisibility="Auto"
						  VerticalScrollBarVisibility="Disabled"
						  Focusable="False"
						  BorderThickness="0">
					<ScrollViewer.Resources>
						<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />
					</ScrollViewer.Resources>

					<Grid>
						<Grid.RowDefinitions>
							<!-- Заголовок -->
							<RowDefinition Height="Auto"/>
							<!-- кнопка ВВЕРХ -->
							<RowDefinition Height="Auto"/>
							<!-- Содержимое ListBox -->
							<RowDefinition Height="*"/>
							<!-- кнопка ВНИЗ -->
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<!-- Заголовок: будет скроллиться по горизонтали, но не по вертикали -->
						<local:TableHeader x:Name="THed" Grid.Row="0"/>

						<Button x:Name="ToUpButton" Grid.Row="1" Style="{StaticResource PopupStyleButton}" Click="ToUpButton_Click"  Padding="-1" Content="▲▲▲▲▲▲▲" Foreground="DarkBlue" Height="20"/>

						<!-- ListBox: без горизонтальной прокрутки, но с вертикальной -->
						<ListBox Grid.Row="2"
							  x:Name="OTSContainer"
							  Margin="2"
							  Background="{StaticResource AppBackBrush}"
							  VirtualizingStackPanel.IsVirtualizing="True"
							  VirtualizingStackPanel.VirtualizationMode="Recycling"
							  PreviewMouseWheel="OTSContainer_PreviewMouseWheel"
							  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							  ScrollViewer.VerticalScrollBarVisibility="Auto"
							  BorderThickness="0">
							<ListBox.Resources>
								<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />
							</ListBox.Resources>
							<ListBox.ItemContainerStyle>
								<Style TargetType="ListBoxItem">
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="BorderThickness" Value="0"/>
									<Setter Property="Focusable" Value="False"/>
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="ListBoxItem">
												<ContentPresenter />
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</ListBox.ItemContainerStyle>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<!--<local:OTSRowControl/>-->
									<!--<local:OTSRowControl SearchTerm="{Binding Text, ElementName=SearchOpisBox}"/>-->
									<local:OTSRowControl SearchTerm="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CurrentSearchTerm}" />
								</DataTemplate>
							</ListBox.ItemTemplate>
							<ListBox.Template>
								<ControlTemplate TargetType="ListBox">
									<!--просто чтобы к скроллу доступ иметь-->
									<ScrollViewer x:Name="InnerScrollViewer"
											  HorizontalScrollBarVisibility="Disabled"
											  VerticalScrollBarVisibility="Auto">
										<ItemsPresenter />
									</ScrollViewer>
								</ControlTemplate>
							</ListBox.Template>
						</ListBox>
						<Button x:Name="ToDownButton" Grid.Row="3" Style="{StaticResource PopupStyleButton}" Click="ToDownButton_Click"  Padding="0" Content="▼▼▼▼▼▼▼" VerticalContentAlignment="Top" Foreground="DarkBlue" Height="20"/>
					</Grid>
				</ScrollViewer>

			</Grid>

			<!-- Итоговая панель (не скроллится ни по горизонтали, ни по вертикали) -->
			<Grid Grid.Row="4" Background="{StaticResource ScrolBarBrush}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="600"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
						<Button x:Name="BtnToExcelReport" Foreground="DarkRed" Style="{StaticResource PopupStyleButton}" Click="BtnToExcelReport_Click">Выдать в EXCEL</Button>

						<Button x:Name="ActiveFiltersButton"  Style="{StaticResource HoverablePopupButton}" Click="ShowActiveFiltersButton_Click" VerticalAlignment="Stretch" Padding="4,2,4,2">
							Актив. фильтры
						</Button>
						<Button x:Name="OTSNumbersBU"  Style="{StaticResource PopupStyleButton}"  Click="Button_Click_5" VerticalAlignment="Stretch">№№ ОТС</Button>
						<Button x:Name="RemoveVoprosBU"  Style="{StaticResource PopupStyleButton}"  Click="RemoveVoprosBU_Click" VerticalAlignment="Stretch">
							Уд. ???
						</Button>
						<Button x:Name="MarkAllBU"  Style="{StaticResource PopupStyleButton}"  Click="MarkAllBU_Click" VerticalAlignment="Stretch">
							Пометити все
						</Button>
						<Button x:Name="DemarkBU"  Style="{StaticResource PopupStyleButton}"  Click="DemarkBU_Click" VerticalAlignment="Stretch">
							Снять помеч.
						</Button>
						<Button x:Name="DelOKBU"  Style="{StaticResource PopupStyleButton}"  Click="DelOKBU_Click" VerticalAlignment="Stretch">
							Удалить ОК
						</Button>
						<Button x:Name="DelAllActionBUBU"  Style="{StaticResource PopupStyleButton}"  Click="DelAllActionBUBU_Click" VerticalAlignment="Stretch">
							Удалить все отметки
						</Button>
					</WrapPanel>


					<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" x:Name="TotalSP">
						<StackPanel.Resources>
							<Style TargetType="TextBlock">
								<Setter Property="TextWrapping" Value="Wrap"/>
								<Setter Property="VerticalAlignment" Value="Center"/>
								<Setter Property="FontWeight" Value="SemiBold"/>
								<Setter Property="Padding" Value="2"/>
								<Setter Property="Margin" Value="5 2"/>
								<Setter Property="TextAlignment" Value="Center"/>
							</Style>
						</StackPanel.Resources>

						<TextBlock x:Name="SumKorr" Foreground="Black" MaxWidth="200" />

						<TextBlock x:Name="PeriodOLDOTS" Foreground="BlueViolet"  MaxWidth="200" PreviewMouseLeftButtonDown="PerDOTS_PreviewMouseDown" ToolTip="LKM - Поменять местами с текущим периодом"/>

						<TextBlock x:Name="PeriodOTS" Foreground="BlueViolet" MaxWidth="200" />

						<TextBlock x:Name="FirstOTS" Foreground="Black" MaxWidth="150" />

						<TextBlock x:Name="LastOTS"  Foreground="Black" MaxWidth="150" />

						<TextBlock x:Name="TekYarl" Text="{Binding PointedHeaderText, Source={StaticResource YarlykService}}" Foreground="DarkRed"  Width="Auto" />

						<TextBlock x:Name="TotalOTS" Foreground="Blue" MaxWidth="130" />
					</StackPanel>
				</Grid>
			</Grid>


			<!-- Всплывающий Попуп -->
			<Popup Name="IdListPopup" Placement="Center" AllowsTransparency="True" StaysOpen="False" >
				<!--обертка для прозрачности-->
				<Border Background="Transparent">
					<Border Background="{StaticResource AppBackBrush}"  BorderBrush="{StaticResource SplitterBrush}" BorderThickness="4" Padding="10" MaxWidth="600" CornerRadius="5">
						<ScrollViewer>
							<ScrollViewer.Resources>
								<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}"/>
							</ScrollViewer.Resources>
							<TextBlock Name="IdListTextBlock" FontSize="14" TextWrapping="Wrap" Background="Transparent" Foreground="Black"/>
						</ScrollViewer>
					</Border>
				</Border>
			</Popup>

			<Popup x:Name="ActiveFiltersPopup"
				   Placement="Center" 
				   StaysOpen="False" 
				   AllowsTransparency="True">
				<local:ActiveFiltersPopup x:Name="ActiveFiltersContentControl" />
			</Popup>
		</Grid>
	</Border>
</UserControl>
