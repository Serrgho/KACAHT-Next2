												 HorizontalAlignment="Right"
												 VerticalAlignment="Top"
												 Margin="0,-2,-2,0"/>
							</Grid>
						</Border>




						<Border Width="80" x:Name="PripMash0LevelBorder"
								Style="{StaticResource FiltrTBlock}"
								PreviewMouseLeftButtonUp="OnLevel0FilterMouseDown"
								PreviewMouseRightButtonUp="OnLevel0FilterMouseRightDown"
								local:FilterProperties.FieldType="String"
								local:FilterProperties.FilterLevel="Level0"
								Tag="PripMash">
							<Grid>
								<!-- Оберни в Grid, чтобы можно было наложить элементы -->
