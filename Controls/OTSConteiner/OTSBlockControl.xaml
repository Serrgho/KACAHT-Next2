															 PropertyName="MestoOTS_Dor"
															 HorizontalAlignment="Right"
															 VerticalAlignment="Top"
															 Margin="0,-2,-2,0"/>
							</Grid>
						</Border>






						<Border Width="55"  x:Name="KrasREG0LevelBorder"
