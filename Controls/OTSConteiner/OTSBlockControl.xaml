<UserControl x:Class="Kas.OTSBlockControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:local="clr-namespace:KACAHT_Next2.Kas"
			 mc:Ignorable="d">
	<UserControl.Resources>
		<local:YarlykSelectionService x:Key="YarlykService" />
		<Style x:Key="TBSTYLE" TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
		<Style x:Key="HoverablePopupButton" BasedOn="{StaticResource PopupStyleButton}" TargetType="Button">
			<Setter Property="Background" Value="DarkRed"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Padding" Value="4,2,4,2"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">

					<Setter Property="Background" Value="#FFB56161"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>


	<Border Background="{StaticResource AppBackBrush}">

		<!-- Общий ScrollViewer: прокручивает ЗАГОЛОВОК и СОДЕРЖИМОЕ по горизонтали -->
		<Grid >
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="auto"/>
				<RowDefinition Height="*" />
				<RowDefinition Height="auto"/>
			</Grid.RowDefinitions>
			<local:WarningFiltersControl x:Name="WarningFilters" Grid.Row="0"
                             ItemsSource="{Binding ItemsSource, ElementName=OTSContainer}" 
                             FilterApplied="WarningFilters_FilterApplied"/>

			<local:NumOTSUserTB x:Name="FindOTS" Grid.Row="1" FilterRequested="NumOTSUserTB_FilterRequested" Cleared="NumOTSUserTB_Cleared" LokRequested="FindOTS_LokRequested"/>





			<Grid Grid.Row="2"  Background="{StaticResource AppBackBrush}" Height="80" Margin="2 0 2 0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="auto"/>
					<ColumnDefinition Width="auto"/>
					<ColumnDefinition Width="auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!--пока невидимый переключатель видимости для поиска по №№ ОТС-->
				<local:MYToggleControl x:Name="NumSearchToggleUC"  MYToggleZagolovok="Поиск по №№ ОТС" IsChecked="False" Click="NumSearchToggleUC_Click" Visibility="Collapsed"/>
				<!--=================================================================-->

				<!--<local:MYToggleControl Grid.Column="1" x:Name="TableItemVisToggleUC" Width="80" MYToggleZagolovok="Статистика" Margin="5 1" IsChecked="False" Click="TableVisToggleUC_Click"/>-->
				<local:MYToggleControl Grid.Column="2" x:Name="SortOrderToggleUC" Width="80" MYToggleZagolovok="Сорт. фильтры" Margin="5 1" IsChecked="False"/>

				<!--добавить в !!! OtkazFilterConfig в Public Function GetDisplaySelector !!!
							 в !!! TableHeader в Private Function BuildStringPredicate !!! 
							 в !!! TableHeader ClearAllFilters !!! 
							 в !!! AddHandler popupCtrl.OkButt.Click !!! для точки синей
							 в !!! OTSBlockControl.vb, в ClearFilters_MouseDown !!!
							 !!! имя свойства = +{0LevelIndicator} !!!  -->
				<!--MestoOTS_Dor-->



				<ScrollViewer Grid.Column="3"  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
					<ScrollViewer.Resources>
						<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />
					</ScrollViewer.Resources>

					<StackPanel Grid.Column="1"  Orientation="Horizontal">

						<Border Background="{StaticResource AppBackBrush}"
                                BorderBrush="{StaticResource SplitterBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="2"
								>
							<StackPanel Orientation="Horizontal">
								<!-- Поле поиска -->
								<TextBox x:Name="SearchOpisBox"
                                         Width="130"
                                         MaxLines="2"
                                         
                                         Padding="4,2"
                                         Foreground="Blue"
                                         FontWeight="SemiBold"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalAlignment="Center"
                                         TextWrapping="Wrap"
                                         TextChanged="SearchOpisBox_TextChanged"
                                         SelectionBrush="{StaticResource ScrolBarBrush}"
                                         SelectionOpacity="0.6"
                                         ToolTip="Поиск по описанию отказа" />

								<!-- Кнопка очистки -->
								<Button x:Name="ClearSearchButton"
                                        Content="❌"
                                        Click="ClearSearchButton_Click"
                                        ToolTip="Очистить поиск"
                                        Style="{StaticResource StyleCloseButton}"
                                        Margin="4 1 1 1"/>

							</StackPanel>
						</Border>





						<Border  Style="{StaticResource FiltrTBlock}" PreviewMouseUp="ClearFilters_MouseDown" >
							<TextBlock x:Name="ClearFilters" Text="❌" Style="{StaticResource TBSTYLE}" Foreground="DarkRed" />
						</Border>

						<Border Width="60" x:Name="PCh0LevelBorder"
                                Style="{StaticResource FiltrTBlock}"
                                PreviewMouseLeftButtonUp="OnLevel0FilterMouseDown"
                                PreviewMouseRightButtonUp="OnLevel0FilterMouseRightDown"
                                local:FilterProperties.FieldType="number"
                                local:FilterProperties.FilterLevel="Level0"
                                Tag="PCh">
							<Grid>
								<!-- Оберни в Grid, чтобы можно было наложить элементы -->
								<TextBlock Text="Поездо-Часы" Style="{StaticResource TBSTYLE}"/>
								<local:Level0FilterIndicator x:Name="PCh0LevelIndicator"
                                                             PropertyName="PCh"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Top"
                                                             Margin="0,-2,-2,0"/>
							</Grid>
						</Border>



						<Border Width="55" x:Name="MestoOTS_Dor0LevelBorder"
								Style="{StaticResource FiltrTBlock}"
								PreviewMouseLeftButtonUp="OnLevel0FilterMouseDown"
								PreviewMouseRightButtonUp="OnLevel0FilterMouseRightDown"
								local:FilterProperties.FieldType="String"
								local:FilterProperties.FilterLevel="Level0"
								Tag="MestoOTS_Dor">
							<Grid>
								<!-- Оберни в Grid, чтобы можно было наложить элементы -->
								<TextBlock Text="Дорога отказа" Style="{StaticResource TBSTYLE}"/>
