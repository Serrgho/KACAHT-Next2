<UserControl x:Class="Kas.EquipmentHierarchyPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d" 
              Width="650" Height="500"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <!-- Стиль для элементов ListBox (для FilterPopup.xaml) -->
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6 1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Border"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True"
                        Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Кружок слева (диаметр 8 → радиус 4) -->
                                <Ellipse x:Name="Dot"
                                 Width="8" Height="8"
                                 Margin="4,0,6,0"
                                 Fill="{TemplateBinding Foreground}" />

                                <!-- Текст справа -->
                                <TextBlock Grid.Column="1"
                                   Text="{TemplateBinding Content}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SplitterBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ScrolBarBrush}"/>
                                <!-- Точка остаётся чёрной при наведении (можно поменять на White, если хочешь) -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      
    </UserControl.Resources>
    
    <Border Background="{StaticResource AppBackBrush}"
            CornerRadius="8"
            BorderBrush="{StaticResource SplitterBrush}"
            BorderThickness="4">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Ур.1 -->
                <RowDefinition Height="*"/>
                <!-- Ур.2 + Ур.3 -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопки -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопки -->
            </Grid.RowDefinitions>

            <!-- Ур.1 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Оборудование Ур.1:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="Level1TextBlock" Grid.Column="1" Margin="10,0,0,0" FontWeight="Bold"/>
            </Grid>

            <!-- Ур.2 и Ур.3 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ур.2 -->
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Уровень 2" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2"/>
                        <ListBox x:Name="Level2ListBox"
                                 Grid.Row="1"
                                 Width="auto"
                                 Background="{StaticResource AppBackBrush}"
                                 BorderThickness="0"
                                 VirtualizingStackPanel.IsVirtualizing="True"  
                                 SelectionChanged="Level2ListBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Resources>
                            <!-- 👇 Подключаем ваш уже существующий стиль -->
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />
                        </ListBox.Resources>
                        </ListBox>
                        
                    </Grid>
                </Border>

                <!-- Разделитель -->
                <!--<GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeWE"/>-->

                <!-- Ур.3 -->
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Уровень 3" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2"/>
                        <ListBox x:Name="Level3ListBox"
                                 Grid.Row="1"
                                 Width="auto"
                                 Background="{StaticResource AppBackBrush}"
                                 BorderThickness="0"
                                 VirtualizingStackPanel.IsVirtualizing="True"  
                                 SelectionChanged="Level3ListBox_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  KeyDown="Level3ListBox_KeyDown"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            
                            <ListBox.Resources>
                                <!-- 👇 Подключаем ваш уже существующий стиль -->
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />
                            </ListBox.Resources>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Кнопки -->
            <Grid Grid.Row="2" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                <Grid Visibility="{Binding ElementName=Level2ListBox, Path=SelectedItem,Converter={StaticResource NullToVisibilityConverter}}" Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"  HorizontalAlignment="Stretch" x:Name="NewLevel3Input"   KeyDown="NewLevel3Input_KeyDown" Padding="2 5" FontSize="15"/>
                    
                        <Button Grid.Column="1" Content="Добавить" Height="30"  Style="{StaticResource PopupStyleButton}" Click="AddLevel3Button_Click" Padding="5 0" Margin="4,0"/>
                    </Grid>
            </Grid>
            
            <!-- Кнопки -->
            <Grid Grid.Row="3"  HorizontalAlignment="Stretch" Margin="0,10,0,0">
                
                <Button x:Name="OkButton" Content="OK" Width="80" Margin="5"
                        Style="{StaticResource PopupStyleButton}"
                        Click="OkButton_Click" IsEnabled="False" HorizontalAlignment="Left"/>
                <Button x:Name="LoadBaseButton" Content="Загрузить базовый список"  Margin="5"
                        Style="{StaticResource PopupStyleButton}"
                        Click="LoadBaseButton_Click" HorizontalAlignment="Center"/>
                <Button Content="Отмена" Width="80" Margin="5"
                        Style="{StaticResource PopupStyleButton}"
                        Click="CancelButton_Click" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
