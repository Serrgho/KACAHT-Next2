<UserControl x:Class="Kas.HistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="HistoryControl.Kas"
             
             Width="45" Height="auto">
            <UserControl.Resources>
                <Style x:Key="Brdr" TargetType="Border">
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Padding" Value="1" />
                    <Setter Property="Margin" Value="1" />
           
                    <Setter Property="Background" Value="{StaticResource AppBackBrush}" />
                    <Setter Property="BorderBrush" Value="Black" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect
                                Color="Black"
                                Opacity="0.2"
                                BlurRadius="6"
                                ShadowDepth="1"
                                Direction="315" />
                        </Setter.Value>
                    </Setter>
                </Style>
            </UserControl.Resources>
	
	<Border Style="{StaticResource Brdr}" Background="{StaticResource ScrolBarBrush}">
		<StackPanel >
			<Border Style="{StaticResource Brdr}" Height="20">
				<TextBlock Text="▲" FontSize="29"
                                   TextAlignment="Center" VerticalAlignment="Center"   MinHeight="41"
                                   PreviewMouseLeftButtonDown="BtnUP_PreviewMouseLeftButtonDown"/>
			</Border>

			<Border x:Name="ChkBRDR" Style="{StaticResource Brdr}" Height="Auto">
				<StackPanel>


					<TextBlock Text="📋" FontSize="25" Foreground="DarkGreen"
							   TextAlignment="Center" VerticalAlignment="Center"
							   PreviewMouseLeftButtonDown="BtnCopy_PreviewMouseLeftButtonDown"/>

					<CheckBox IsChecked="{Binding SelectedEntry.IsRed, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
								VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0">
						
						<CheckBox.Template>
							<ControlTemplate TargetType="CheckBox">
								<TextBlock x:Name="BoxSymbol"
										   Text="☐"
										   FontSize="23"
										   MaxHeight="27"
										   TextAlignment="Center"
										   VerticalAlignment="Center"
										   HorizontalAlignment="Center"/>
								<ControlTemplate.Triggers>
									<Trigger Property="IsChecked" Value="True">
										<Setter TargetName="BoxSymbol" Property="Text" Value="☑"/>
										<Setter TargetName="BoxSymbol" Property="FontSize" Value="21"/>
									</Trigger>
									<!--<Trigger Property="IsMouseOver" Value="True">
										<Setter Property="Background" Value="{StaticResource ScrolBarBrush}"/>
									</Trigger>-->
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</CheckBox.Template>
					</CheckBox>

					<TextBlock Text="❌" FontSize="25" Foreground="DarkRed"
                       TextAlignment="Center" VerticalAlignment="Center"
                       PreviewMouseLeftButtonDown="BtnDel_PreviewMouseLeftButtonDown"/>
					
				</StackPanel>

			</Border>

			<Border Style="{StaticResource Brdr}"  Height="20">
				<TextBlock Text="▲" FontSize="29"
                                   TextAlignment="Center" VerticalAlignment="Center"  MinHeight="41"
                                   PreviewMouseLeftButtonDown="BtnDOWN_PreviewMouseLeftButtonDown"
                                   RenderTransformOrigin="0.5,0.5">
					<TextBlock.RenderTransform>
						<TransformGroup>
							<ScaleTransform ScaleY="-1"/>
							<SkewTransform/>
							<RotateTransform/>
							<TranslateTransform/>
						</TransformGroup>
					</TextBlock.RenderTransform>
				</TextBlock>
			</Border>
		</StackPanel>
	</Border>

</UserControl>
