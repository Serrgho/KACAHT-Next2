<Window x:Class="Kas.OtkazInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KACAHT_Next2.Kas"
        mc:Ignorable="d"
        Title="OtkazInspectorWindow" WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
		MaxWidth="600" MaxHeight="800"
        FontFamily="Segoe UI"
        FontSize="12">

	<Window.Resources>
		<!-- Стиль для колонки "Имя" (выравнивание по левому краю) -->
		<Style x:Key="NameCellStyle" TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="6,2,4,2"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

		<!-- Стиль для колонок "Категория" и "Тип" (по центру) -->
		<Style x:Key="CenterCellStyle" TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="4,2"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		<!-- Стиль для колонки "Значение" (с переносами, по левому краю) -->
		<Style x:Key="ValueCellStyle" TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
			<Setter Property="Padding" Value="6,2,4,2"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
	</Window.Resources>

	<Grid Background="{StaticResource AppBackBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- 📊 Заголовок / Статистика -->
		<Border Grid.Row="0" Margin="5,5,5,2" Padding="8,4">
			<TextBlock x:Name="txtStats" FontSize="13" FontWeight="SemiBold" 
                       Foreground="DarkSlateGray" VerticalAlignment="Center"/>
		</Border>

		<!-- 📋 Таблица -->
		<DataGrid x:Name="dgInspector" Grid.Row="1"
                  HorizontalAlignment="Stretch"   
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#D7DEA9"
                  FontSize="12"
                  FontFamily="Segoe UI"
                  BorderThickness="0"
                  Margin="5,0,5,5"
                  HeadersVisibility="Column"
				   SelectionChanged="DgInspector_SelectionChanged">

			<DataGrid.Resources>
				<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />

				<Style TargetType="DataGridCell">
					<Setter Property="Padding" Value="4,2"/>
					<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
					<Style.Triggers>
						<Trigger Property="IsSelected" Value="True">
							<Setter Property="Background" Value="{StaticResource SplitterBrush}"/>
							<Setter Property="Foreground" Value="{StaticResource AppBackBrush}"/>
							<Setter Property="FontWeight" Value="SemiBold"/>
						</Trigger>
					</Style.Triggers>
				</Style>

				<Style TargetType="TextBlock">
					<Setter Property="TextWrapping" Value="Wrap"/>
					<Setter Property="VerticalAlignment" Value="Center"/>
					<Setter Property="HorizontalAlignment" Value="Center"/>
					<Setter Property="Padding" Value="4,2"/>
				</Style>

				<Style TargetType="DataGridColumnHeader">
					<Setter Property="Padding" Value="6,4"/>
					<Setter Property="FontSize" Value="13"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
					<Setter Property="Background" Value="{StaticResource ScrolBarBrush}"/>
					<Setter Property="VerticalAlignment" Value="Center"/>
					<Setter Property="HorizontalContentAlignment" Value="Center"/>
					<Setter Property="BorderBrush" Value="{StaticResource ScrolBarBrush}"/>
					<Setter Property="BorderThickness" Value="0,0,1,1"/>
				</Style>
			</DataGrid.Resources>

			<DataGrid.Columns>
				<!-- 1. Категория -->
				<DataGridTextColumn Binding="{Binding Category}"
                                    Width="Auto"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource CenterCellStyle}">
					<DataGridTextColumn.Header>
						<TextBlock Text="Тип"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="4,2"/>
					</DataGridTextColumn.Header>
				</DataGridTextColumn>

				<!-- 2. Имя -->
				<DataGridTextColumn Binding="{Binding Name}"
                                    Width="150"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource NameCellStyle}">
					<DataGridTextColumn.Header>
						<TextBlock Text="Имя"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="4,2"/>
					</DataGridTextColumn.Header>
				</DataGridTextColumn>

				<!-- 3. Тип -->
				<DataGridTextColumn Binding="{Binding Type}"
                                    Width="150"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource CenterCellStyle}">
					<DataGridTextColumn.Header>
						<TextBlock Text="Тип данных"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="4,2"/>
					</DataGridTextColumn.Header>
				</DataGridTextColumn>

				<!-- 4. Значение -->
				<DataGridTextColumn Binding="{Binding Value}"
                                    Width="*"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource ValueCellStyle}">
					<DataGridTextColumn.Header>
						<TextBlock Text="Значение"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="4,2"/>
					</DataGridTextColumn.Header>
				</DataGridTextColumn>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>




