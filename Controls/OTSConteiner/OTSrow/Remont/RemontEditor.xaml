<UserControl x:Class="Kas.RemontEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d"
             MinWidth="480"
             Background="Transparent">
	<UserControl.Resources>
		<Style x:Key="RemontTextBoxStyle" TargetType="TextBox">
			<Setter Property="Margin" Value="2"/>
			<Setter Property="Padding" Value="3,2"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Background" Value="{StaticResource ScrolBarBrush}"/>
			<EventSetter Event="PreviewMouseLeftButtonDown" Handler="TextBox_SelectAll_OnPreviewMouseLeftButtonDown"/>
			<EventSetter Event="GotKeyboardFocus" Handler="TextBox_GotKeyboardFocus"/>
		</Style>
		<Style x:Key="ArrowBtnStyle" TargetType="Button">
			<Setter Property="Width" Value="22"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="Margin" Value="2,0,0,0"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="ToolTip" Value="Выбрать из списка"/>
		</Style>
	</UserControl.Resources>

	<Border Margin="0" Padding="5" BorderBrush="{StaticResource SplitterBrush}" CornerRadius="4" BorderThickness="4" Background="{StaticResource AppBackBrush}">
		<Grid >
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- Заголовок -->
			<TextBlock Grid.Row="0" Text="Данные на локомотив" 
					   FontSize="15" FontWeight="Bold" 
					   HorizontalAlignment="Center" Margin="0,0,0,6"/>

			<!-- ===== БОЛЬШОЙ РЕМОНТ ===== -->
			<TextBlock Grid.Row="1" Text="Большой ремонт" FontWeight="Bold" 
					   Foreground="DarkBlue" Margin="0,0,0,3"/>

			<!-- Вид + Пробег + Место + стрелка -->
			<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
				<ComboBox x:Name="CmbRepairType" Style="{StaticResource MyCombo}" 
						  Width="75" Margin="0,0,3,0" Padding="2"
						  FontSize="13" FontWeight="Bold"
						  VerticalContentAlignment="Center"/>
				<TextBox x:Name="TxtMileage" Style="{StaticResource RemontTextBoxStyle}" 
						 Width="65" TextAlignment="Center" ToolTip="Пробег км"/>
				<TextBox x:Name="TxtMajorPlace" Style="{StaticResource RemontTextBoxStyle}" 
						 Width="170" TextAlignment="Left" Margin="3,2,0,2"
						 ToolTip="Место ремонта"/>
				<Button x:Name="BtnPickMajor" Content="▼" 
						Style="{StaticResource ArrowBtnStyle}"
						Click="BtnPickMajor_Click"/>
			</StackPanel>

			<!-- ===== ТО-2 ===== -->
			<TextBlock Grid.Row="3" Text="ТО-2" FontWeight="Bold" 
					   Foreground="DarkGreen" Margin="0,4,0,3"/>

			<StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,4">
				<TextBox x:Name="TxtTO2Place" Style="{StaticResource RemontTextBoxStyle}" 
						 Width="240" TextAlignment="Left"
						 ToolTip="Место проведения ТО-2"/>
				<Button x:Name="BtnPickTO2" Content="▼" 
						Style="{StaticResource ArrowBtnStyle}"
						Click="BtnPickTO2_Click"/>
			</StackPanel>

			<!-- ===== ПОПАП ВЫБОРА МЕСТА (скрыт по умолчанию) ===== -->
			<Border Grid.Row="5" x:Name="PickerBorder" 
					Visibility="Collapsed"
					BorderBrush="Gray" BorderThickness="1" 
					Background="{StaticResource AppBackBrush}"
					Margin="0,4,0,4" Padding="6">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<!-- RadioButton: СЛД / Заводы -->
					<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
						<RadioButton x:Name="RbSLD" Content="СЛД по дорогам" 
									 Margin="0,0,15,0" 
									 Checked="RbCategory_Changed"/>
						<RadioButton x:Name="RbFactories" Content="Заводы" 
									 Margin="0,0,15,0"
									 Checked="RbCategory_Changed"/>
					</StackPanel>

					<!-- Панель СЛД: дороги + список СЛД -->
					<StackPanel Grid.Row="1" x:Name="PnlSLD" Orientation="Vertical">
						<TextBlock Text="Железная дорога:" FontWeight="Bold" FontSize="12" Margin="0,0,0,2"/>
						<StackPanel Orientation="Horizontal">
							 <ComboBox x:Name="CmbRoad" Style="{StaticResource MyCombo}" 
								  Width="Auto" HorizontalAlignment="Left"
								  Margin="0,0,0,4" Padding="2" FontSize="13"
								  SelectionChanged="CmbRoad_SelectionChanged"/>
							<ComboBox	x:Name="CmbSLD" Style="{StaticResource MyCombo}" 
										Width="Auto" Padding="2" FontSize="13"  
										VerticalContentAlignment="Center" 	 
										SelectionChanged="CmbSLD_SelectionChanged"/>
						</StackPanel>
						
						 
					</StackPanel>

					<!-- Панель Заводов -->
					<StackPanel Grid.Row="2" x:Name="PnlFactories" Orientation="Vertical">
						<TextBlock Text="Локомотиворемонтные и локомотивостроительные заводы:" 
								   FontWeight="Bold" FontSize="12" Margin="0,0,0,2" TextWrapping="Wrap"/>
						
						<ComboBox	x:Name="CmbFactories" Style="{StaticResource MyCombo}" 
									Width="Auto" Padding="2" FontSize="13"
									VerticalContentAlignment="Center"
									SelectionChanged="CmbFactories_SelectionChanged"/>
					</StackPanel>

					<!-- Кнопки подтверждения -->
					<StackPanel Grid.Row="3" Orientation="Horizontal" 
								HorizontalAlignment="Right" Margin="0,6,0,0">
						<Button Content="Применить" x:Name="BtnApplyPick" 
								Click="BtnApplyPick_Click"
								Style="{StaticResource PopupStyleButtonGreen}" 
								Width="90" Margin="0,0,6,0" IsEnabled="False"/>
						<Button Content="Закрыть" Click="BtnClosePicker_Click"
								Style="{StaticResource PopupStyleButton}" Width="70"/>
					</StackPanel>
				</Grid>
			</Border>

			<!-- ===== КНОПКИ ОК / ОТМЕНА ===== -->
			<StackPanel Grid.Row="7" Orientation="Horizontal" 
						HorizontalAlignment="Right" Margin="0,8,0,0">
				<Button Content="✔️" x:Name="BtnOk" Click="BtnOk_Click"
						Style="{StaticResource PopupStyleButton}" 
						Width="Auto" Foreground="DarkGreen" Margin="0,0,8,0" IsDefault="True"/>
				<!--<Button Content="Отмена" Click="BtnCancel_Click"
						Style="{StaticResource PopupStyleButton}" 
						Width="80" IsCancel="True"/>-->
			</StackPanel>
		</Grid>
	</Border>

	
</UserControl>