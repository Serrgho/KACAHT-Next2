<UserControl x:Class="Kas.HistoryEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d">


	<Grid Margin="2,5,2,2">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Rectangle Margin="0,0,0,5" Grid.Row="0" Height="2"  
           Stroke="{StaticResource SplitterBrush}" 
           StrokeThickness="2"
           StrokeDashArray="2 2 2 2 6 2 6 2 6 2 2 2 2 2 10"/>

		<StackPanel Grid.Row="1">
		<!-- Настройки даты -->
		<Grid >
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<CheckBox x:Name="ShowDateCBox" 
                      IsChecked="{Binding ShowDate, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0 0 10 0"/>

			<TextBlock Grid.Column="1" Text="Дата" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="Black" Margin="0 0 10 0"/>

			<DatePicker x:Name="DatePickerControl"
                        Grid.Column="2"
						Margin="0,0,0,3"
                        SelectedDate="{Binding EventDate, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                        Visibility="{Binding IsChecked, ElementName=ShowDateCBox, Converter={StaticResource BoolToVisConverter}}"
                        Width="130"/>
		</Grid>

		<!-- Поле ввода текста -->
		<TextBox x:Name="TxtDescription" 
                 Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                         
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Padding="4" BorderBrush="#CCCCCC" PreviewKeyDown="TxtDescription_PreviewKeyDown"/>

		<!-- Кнопки управления -->
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 5 0 0">
			<Button Content="❌" 
                    Padding="5 2"
					Height="25"
					Click="BtnCancel_Click"
                    Style="{StaticResource PopupStyleButton}"
                    Foreground="DarkRed"/>

			<Button Content="✔️" 
                    Padding="5 2"
					Height="25"
                    Click="BtnAdd_Click"
                    Style="{StaticResource PopupStyleButton}"
                    Foreground="DarkGreen"/>
		</StackPanel>
	</StackPanel>
    </Grid>
	




</UserControl>
