<UserControl x:Class="Kas.HistoryOTSControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas" d:DataContext="{d:DesignInstance Type=local:Otkaz}"
			 mc:Ignorable="d">
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>

		<ListBox Grid.Row="0" Grid.Column="0" x:Name="HistList" ItemsSource="{Binding History}" Style="{StaticResource HistoryListBoxStyle}">
			<!-- ⚠️ ВАЖНО ПРО СОБЫТИЕ (EventSetter) -->
			<!-- Так как стиль вынесен, Handler="..." работать не будет, если метод в коде окна. -->
			<!-- Добавить EventSetter локально в стиль ListBoxItem здесь -->
			<ListBox.ItemContainerStyle>
				<Style BasedOn="{StaticResource HistoryListBoxItemStyle}" TargetType="ListBoxItem">
					<EventSetter Event="MouseRightButtonUp" Handler="ListBoxItem_MouseRightButtonDown"/>
					<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
				</Style>
			</ListBox.ItemContainerStyle>
		</ListBox>
		<!-- 2. Кнопка активации (Строка 1, Колонка 1 - справа) -->
		<Button x:Name="BtnAddHistory" 
        Grid.Row="1" Grid.Column="1" 
        Content="➕" 
        Click="BtnAddHistory_Click" 
        Style="{StaticResource PopupStyleButton}" 
        Foreground="DarkBlue"
        Margin="5"/>

		<!-- 3. Контрол ввода (Строка 1, Колонка 0 - слева) -->
		<!-- Изначально он скрыт (Visibility=Collapsed внутри самого HistoryEditor) -->
		<local:HistoryEditor x:Name="HistEditorCtrl" 
                             Grid.Row="1" 
                             Grid.Column="0"
							  Cancelled="HistEditorCtrl_Cancelled" 
                             EntryAdded="HistEditorCtrl_EntryAdded"
                             Margin="0 5 5 5"/>

		<!-- это в кнце -->
		<Popup x:Name="HistoryPop"
               PlacementTarget="{Binding ElementName=HistList}"
               Placement="Right" 
               StaysOpen="False"
			   Closed="HistoryPop_Closed"
               AllowsTransparency="True">
			<!-- Создайте новый экземпляр или используйте тот же тип -->
			<local:HistoryControl x:Name="HistoryUC"/>
		</Popup>

	</Grid>
</UserControl>
