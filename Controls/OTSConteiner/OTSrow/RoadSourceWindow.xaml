<Window x:Class="Kas.RoadSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        WindowState="Normal"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="{StaticResource AppBackBrush}" BorderThickness="2" BorderBrush="{StaticResource SplitterBrush}" CornerRadius="4" Width="600">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Возврат отказа: дорога и цель" 
                       FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

            <!-- Две колонки: Дороги | Цели -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="RoadPanel" Grid.Column="0" MaxHeight="300" Margin="0,0,10,0"/>
                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource SplitterBrush}" Margin="5,0"/>
                <StackPanel x:Name="PurposePanel" Grid.Column="2" MaxHeight="300" Margin="10,0,0,0"/>
            </Grid>

            <!-- TextBox для своей причины -->
            <TextBox x:Name="CustomPurposeTB" Grid.Row="2" 
                     Margin="0,10,0,0" Padding="5" Height="25"
                     TextWrapping="NoWrap" VerticalContentAlignment="Center"
                     Tag="Введите свою причину (необязательно)"/>
 <!--BorderBrush="{StaticResource SplitterBrush}"
                       BorderThickness="1" CornerRadius="3"-->
            <!--Foreground="{StaticResource InfoBrush}"-->
            <!-- Превью итогового текста -->
            <TextBlock x:Name="PreviewTextBlock" Grid.Row="3" 
                       Margin="0,8,0,0" Padding="8,6"
                       Background="{StaticResource AppBackBrush}"
                      
                       FontSize="12" FontStyle="Italic"
                       
                       Text="Ожидание выбора..."/>

            <!-- Кнопки OK/Отмена -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Button Content="OK" Width="70" Height="25" Margin="5" IsDefault="True" Click="OkButton_Click" HorizontalAlignment="Left"/>
                <Button Content="Отмена" Width="70" Height="25" Margin="5" IsCancel="True" Click="CancelButton_Click" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>




