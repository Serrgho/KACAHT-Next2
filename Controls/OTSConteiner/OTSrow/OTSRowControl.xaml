<UserControl x:Class="Kas.OTSRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:KACAHT_Next2.Kas" 
             d:DataContext="{d:DesignInstance Type=local:Otkaz}"
             mc:Ignorable="d">
	<UserControl.Resources>
		         
	</UserControl.Resources>
    <Grid x:Name="MainGridd" PreviewMouseDown="Grid_PreviewMouseDown" Background="Transparent">
        
        <Grid.Resources>
			 <local:IsNotEmptyConverter x:Key="IsNotEmptyConverter"/>
             <!--Стиль для Rectangle -->
            <Style TargetType="Rectangle" x:Key="TableRowBorderStyle">
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeThickness" Value="3" />
                <Setter Property="Fill" Value="#4D000000" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
			
			<Style TargetType="Border" x:Key="ActiveBorderStyle">
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="BorderBrush" Value="Transparent"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="Margin" Value="2 3 2 4"/>
				<!-- Увеличил для видимости -->
				<Setter Property="CornerRadius" Value="8"/>

				<Style.Triggers>
					<!-- Логика: IsMouseOver=True И HasText=False (Рамка) -->
					<MultiDataTrigger>
						<MultiDataTrigger.Conditions>
							<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
							<Condition Binding="{Binding (local:BorderExtensions.HasText), RelativeSource={RelativeSource Self}}" Value="False"/>
						</MultiDataTrigger.Conditions>
						
						<Setter Property="BorderBrush" Value="Black"/>
						<Setter Property="Effect">
							<Setter.Value>
								<DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.7" Color="Black" RenderingBias="Performance"/>
							</Setter.Value>
						</Setter>
					</MultiDataTrigger>

					<!-- Логика: IsMouseOver=True И HasText=True (Тень) -->
					<MultiDataTrigger>
						<MultiDataTrigger.Conditions>
							<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
							<Condition Binding="{Binding (local:BorderExtensions.HasText), RelativeSource={RelativeSource Self}}" Value="True"/>
						</MultiDataTrigger.Conditions>
						<Setter Property="Effect">
							<Setter.Value>
								<DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="270" Opacity="0.9" Color="{StaticResource SplitterColor}" RenderingBias="Performance"/>
							</Setter.Value>
							
						</Setter>
						
					</MultiDataTrigger>
					
				</Style.Triggers>
			</Style>
        </Grid.Resources>


        <local:UniversalGrid x:Name="UniGrid" Background="{Binding OTSBackColorBrush}" MinHeight="150">
            
            <Border Grid.Column="0" Padding="2"  >
                <Path  Width="auto" Data="M 4,2 L 20,11 L 4,20 L 4,2 Z" HorizontalAlignment="Center" Style="{StaticResource Colum0}"/>
                </Border>
                
                
                <CheckBox Grid.Column="1" Width="auto" 
                          IsChecked="{Binding Marked}"
                          Checked="MarkedCheckBox_Changed"
                          Unchecked="MarkedCheckBox_Changed"
                          HorizontalContentAlignment="Center" 
                          VerticalContentAlignment="Center" />

            <Grid Grid.Column="2" Background="{Binding IDBackColorBrush}" >
                    <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                
                <Label Grid.Row="0"  Width="auto" Content="{Binding Id}"   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Bottom" PreviewMouseLeftButtonDown="Label_PreviewMouseRightButtonDown"  PreviewMouseRightButtonUp="Label_PreviewMouseRightButtonUp">
                    <Label.Style>
                        <Style TargetType="Label">
                            <Style.Triggers>
                                 <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property = "FontWeight" Value="Bold"/>
                            </Trigger>
                            </Style.Triggers>
                           
                        </Style>
                    </Label.Style>
                    
                </Label>
                    
                    <Grid Grid.Row="1" Margin="0 3">
                        <Ellipse Fill="{StaticResource AppBackBrush}" Width="39" Height="39"  Stroke="{StaticResource ScrolBarBrush}" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Label Content="{Binding Kat}"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="18">
                            <Label.Style>
                                <Style TargetType="Label">
                                    <!-- Базовый стиль -->
                                    <Setter Property="Foreground" Value="Red" />
                                    <Style.Triggers>
                                        <!--{Binding Content, RelativeSource={RelativeSource Self}}-->
                                        <DataTrigger Binding="{Binding Kat}" Value="3">
                                            <Setter Property="Foreground" Value="Black" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>
                    </Grid>
                <Label Grid.Row="2" Width="auto" Content="{Binding FormattedPCh}" HorizontalContentAlignment="Center"  VerticalContentAlignment="Center" VerticalAlignment="Top" Margin="0 0 0 3">
                        <Label.Style>
                            <Style TargetType="Label">
                                <!-- Базовый стиль -->
                                <Setter Property="FontWeight" Value="Normal" />
                                <!-- Триггер: если Uchet = True -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Uchet,NotifyOnTargetUpdated=True}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Uchet,NotifyOnTargetUpdated=True}" Value="False">
                                        <Setter Property="FontWeight" Value="Normal" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>
                </Grid>

            <ContentControl Grid.Column="3"  Width="auto"  Foreground= "{Binding DateColorBrush}" Style="{StaticResource DateContentControlStyle}"  FontWeight="{Binding DateFontWeightStyle}" Content="{Binding Nach}" ContentStringFormat="{}{0:dddd, dd.MM.yyyy}" Tag="True" Language="ru-RU"/>
                
                <Label Grid.Column="4" Width="auto"  Content="{Binding  DisplayDaysOnRassled}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

			<Border Grid.Column="5"  local:BorderExtensions.HasText="{Binding Postup, Converter={StaticResource IsNotEmptyConverter}}" Style="{StaticResource ActiveBorderStyle}">
				 <ContentControl x:Name="PostupField" 
                Width="auto" Content="{Binding Postup}"
                Foreground="Black"
                Style="{StaticResource DateWithWeekdayContentControlStyle}"
                Tag="False"
                MouseRightButtonUp="OpenCalendarForDateField"
                Language="ru-RU"/>
			</Border>

			<Border Grid.Column="6"  local:BorderExtensions.HasText="{Binding VernulsaOTS, Converter={StaticResource IsNotEmptyConverter}}" >
				<ContentControl x:Name="VernField"  Width="auto" Content="{Binding VernulsaOTS}" Foreground="Black" Style="{StaticResource DateWithWeekdayContentControlStyle}" Tag="False"     MouseRightButtonUp="OpenCalendarForDateField" Language="ru-RU"/>
			</Border>

			<Border Grid.Column="7" local:BorderExtensions.HasText="{Binding Istochnik, Converter={StaticResource IsNotEmptyConverter}}" Style="{StaticResource ActiveBorderStyle}">
				     <TextBlock x:Name="IstochTBlock" Width="auto" Text="{Binding Istochnik}" TextAlignment="Center" VerticalAlignment="Center"  TextWrapping="Wrap" PreviewMouseRightButtonUp="IstochTBlock_PreviewMouseRightButtonDown"/>
			</Border>


			<Border Grid.Column="8" local:BorderExtensions.HasText="{Binding KtoZakryl, Converter={StaticResource IsNotEmptyConverter}}" Style="{StaticResource ActiveBorderStyle}">
				   <TextBlock x:Name="KtoZakTBlock"  Width="auto" Text="{Binding KtoZakryl}" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" PreviewMouseRightButtonUp="KtoZakTBlock_PreviewMouseRightButtonUp"/>
			</Border>
            

            
                <StackPanel Grid.Column="9" VerticalAlignment="Center" >
                    <Label  Margin="5 2" FontSize="15" FontWeight="SemiBold" FontStyle="Normal" VerticalAlignment="Bottom" PreviewMouseRightButtonUp="IsStationPAN_PreviewMouseRightButtonUp" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <Label.Style>
                            <Style TargetType="Label" >
                                <Setter Property="Content"  Value="{Binding IsStation_TXT}"/>
							
							<Style.Triggers>
                                    <!-- Станция -->
                                    <DataTrigger Binding="{Binding IsStation}" Value="True">
                                    <Setter Property="Foreground" Value="Black"/>
                                        <!--<Setter Property="FontWeight" Value="Bold"/>-->
                                    </DataTrigger>

                                    <!-- Перегон -->
                                    <DataTrigger Binding="{Binding IsStation}" Value="False">
                                    <Setter Property="Foreground" Value="Blue"/>
                                        <!--<Setter Property="FontWeight" Value="Normal"/>-->
                                    </DataTrigger>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Effect">
										<Setter.Value>
											<DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="Black"/>
										</Setter.Value>
									</Setter>
								</Trigger>
                                   
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>

				    <ContentControl Grid.Row="1"
                                            x:Name="MestoTBlok"
                                            Content="{Binding MestoOTS_TXT, Converter={StaticResource PlaceFormatterConverter}}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Top"
                                            Margin="3 2 3 10"
                                            Padding="0">
					    <ContentControl.Style>
						    <Style TargetType="ContentControl">
							    <Style.Triggers>
								    <DataTrigger Binding="{Binding IsSaved}" Value="True">
									    <Setter Property="Foreground" Value="Red" />
								    </DataTrigger>
							    </Style.Triggers>
						    </Style>
					    </ContentControl.Style>
				    </ContentControl>
			</StackPanel>
                

            <Grid Grid.Column="10" Width="auto" Margin="0 4 0 2">
                <Border CornerRadius="4" Padding="2" Style="{StaticResource ViolBord}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="90"/>
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" Orientation="Vertical">

							<Border Margin="2 2" Padding="2 2" BorderThickness="0 0.5 0 0.5"  Style="{StaticResource ViolBord}">
								<StackPanel  Orientation="Horizontal" VerticalAlignment="Top" >
									<!-- Локомотив -->
									<TextBlock x:Name="LokTB" Text="Локомотив:" FontWeight="Bold" TextAlignment="Left" Margin="2 2 5 2" Style="{StaticResource ViolTBox}" PreviewMouseRightButtonUp="LokTB_PreviewMouseRightButtonUp"/>
									<TextBlock x:Name="LokPrip" Text="{Binding SerLokPripLokTXT}" Margin="5 2 5 2" TextWrapping="Wrap" Style="{StaticResource ViolTBox}" TextAlignment="Justify" MouseDown="LokPrip_MouseDown"/>

									<!-- Машинист -->
									<TextBlock x:Name="MashTB" Text="Машинист:" FontWeight="Bold" TextAlignment="Left" Margin="5 2 5 2" Style="{StaticResource RedTBox}" PreviewMouseRightButtonUp="MashTB_PreviewMouseRightButtonUp"/>
									<TextBlock x:Name="MashFamTB" Text="{Binding MashPripTXT}" Margin="5 2 2 2" TextWrapping="Wrap" Style="{StaticResource ViolTBox}" TextAlignment="Justify"  MouseDown="MashFamTB_MouseDown"/>
								</StackPanel>
							</Border>
							
                            <TextBlock x:Name="TxtBLK" Margin="2 5" Text="{Binding Opis}" TextAlignment="Justify" FontFamily="Times New Roman" FontSize="17" LineHeight="16.5" Style="{StaticResource ViolTBox}" TextWrapping="Wrap"/>

                            <ListBox x:Name="HistTxtBLK" ItemsSource="{Binding History}" Style="{StaticResource HistoryListBoxStyle}">
                                <!-- ⚠️ ВАЖНО ПРО СОБЫТИЕ (EventSetter) -->
                                <!-- Так как стиль вынесен, Handler="..." работать не будет, если метод в коде окна. -->
                                <!-- Добавить EventSetter локально в стиль ListBoxItem здесь -->
                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource HistoryListBoxItemStyle}" TargetType="ListBoxItem">
                                        <EventSetter Event="MouseRightButtonUp" Handler="ListBoxItem_MouseRightButtonDown"/>
										
									</Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>

						<Border Grid.Column="1" BorderBrush="{StaticResource SplitterBrush}" >
							<ListBox Grid.Column="1" x:Name="PlanTxtBLK" ItemsSource="{Binding Plan}" Background ="Transparent"   ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseRightButtonUp="PlanTxtBLK_MouseLeftButtonUp" BorderThickness="0.5 0 0.5 0" Margin="5 0 0 0">

								<ListBox.ItemContainerStyle>

									<Style TargetType="ListBoxItem" BasedOn="{StaticResource PlanListBoxItemStyle}">
										<EventSetter Event="MouseRightButtonUp" Handler="ListBoxItem_MouseRightButtonDown"/>
										<EventSetter Event="MouseEnter" Handler="PlanItem_MouseEnter"/>
										<EventSetter Event="MouseLeave" Handler="PlanItem_MouseLeave"/>
									</Style>
								</ListBox.ItemContainerStyle>

								<ListBox.ItemTemplate>

									<DataTemplate>
										<TextBlock Text="{Binding Description}" 
                           HorizontalAlignment="Stretch" 
                           TextWrapping="Wrap" />
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
                        </Border>
						


					</Grid>
                    
                </Border>
                <!--<Path Grid.Row="1" Style="{StaticResource DashedSeparatorStyle}" VerticalAlignment="Bottom" />-->
            </Grid>


			<Border Grid.Column="11" local:BorderExtensions.HasText="{Binding MyKlasLev3_TXT, Converter={StaticResource IsNotEmptyConverter}}" Style="{StaticResource ActiveBorderStyle}">
				 <TextBlock   x:Name="OborudTB" 
                         PreviewMouseRightButtonUp="OborudTB_PreviewMouseRightButtonUp"
                         Width="auto"
                         Text="{Binding MyKlasLev3_TXT}"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         Padding="3 1"/>
			</Border>
            
			
                <ItemsControl Grid.Column="12" ItemsSource="{Binding DaNaLok}" VerticalAlignment="Center" Margin="3">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="0 5">
                                <!-- 1. Имя ремонта -->
                                <TextBlock Text="{Binding RepairType}" FontWeight="Bold" Padding="0 0 3 0"/>
                                <!-- 3. Предприятие -->
                                <TextBlock Text="{Binding RepairPlace}" TextWrapping="Wrap"/>
                                <!-- 2. Пробег (только если есть) -->
                                <TextBlock Padding="0 0 3 0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <!-- ПРАВИЛЬНО: через вложенный Setter.Value + Binding -->
                                            <Setter Property="Visibility">
                                                <Setter.Value>
                                                    <Binding Path="Mileage" Converter="{StaticResource MileageToVisibilityConverter}"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Text" Value="{Binding Mileage, StringFormat={}{0} км}"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>





			<Border Grid.Column="13" PreviewMouseUp="ZakemTBlock_PreviewMouseUp"   
					local:BorderExtensions.HasText="{Binding ZaKem, Converter={StaticResource IsNotEmptyConverter}}" Style="{StaticResource ActiveBorderStyle}"> 
					
					<StackPanel Grid.Column="12"  Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5 2">
                        
                    <TextBlock x:Name="ZakemTBlock" Text="{Binding ZaKem}" Padding="3 1" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="(Сохранен)" FontWeight="Bold" Padding="3,1" TextAlignment="Center" Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisConverter}}"/>
                </StackPanel>
                </Border>
                    
                
                
                <Grid Grid.Column="15"  Width="auto">
                    <local:ActionsUserControl x:Name="ActionUC"  VerticalAlignment="Stretch" Padding="2"/>
                </Grid>
            </local:UniversalGrid>
        <Grid >
            <local:WarningUserControl Grid.Row="2" x:Name="InOpisWarnCTRL" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140 2 2 2" MaxWidth="420"/>
        </Grid>
		<local:PlanSelectPopup x:Name="PlanPopup" 
                           Grid.RowSpan="99" 
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>

		<Popup x:Name="HistoryPop"
               PlacementTarget="{Binding ElementName=HistTxtBLK}"
               Placement="Right" 
               StaysOpen="False" 
               Closed="HistoryPop_Closed"
               AllowsTransparency="True">
			<local:HistoryControl x:Name="HistoryUC"  PopupOwner="{Binding ElementName=HistoryPop}"/>
        </Popup>

		
		<Rectangle x:Name="HighlightRect" Style="{StaticResource TableRowBorderStyle}" d:Visibility="Collapsed"/>

        <!-- Триггеры на уровне Grid -->


        <Grid.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HighlightRect"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0.52"
                                     Duration="0:0:0.2" />
                        <ColorAnimation Storyboard.TargetName="HighlightRect"
                                    Storyboard.TargetProperty="Stroke.Color"
                                    To="Blue"
                                    Duration="0:0:0" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="HighlightRect"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="0:0:0.1" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

		









	</Grid>
    




</UserControl>
