<Window x:Class="Kas.ZakemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KACAHT_Next2.Kas"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        WindowState="Normal"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="{StaticResource AppBackBrush}" 
            BorderThickness="4" 
            BorderBrush="{StaticResource SplitterBrush}" 
            CornerRadius="4" 
            Width="350">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="Zagolovok" Grid.Row="0" 
                       Text="------" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       Margin="0,0,0,15"/>

            <!-- Сюда будем добавлять кнопки -->
            <!-- Скролл с кастомным стилем MaxHeight="300" -->
            <ScrollViewer Grid.Row="1" 
                          
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}" 
                           BasedOn="{StaticResource CustomScrollBarStyle}" />
                </ScrollViewer.Resources>

                <!-- Сюда будем добавлять кнопки -->
                <StackPanel x:Name="RadioPanel"/>
            </ScrollViewer>

			<!-- Панель для чекбокса и текстбокса (скрыта по умолчанию) -->
			<Border x:Name="PanelAlienSLD" Grid.Row="2" Margin="0,10,0,5" d:Visibility="Visible" Visibility="Collapsed">
                 <Grid >
				    <Grid.ColumnDefinitions>
					    <ColumnDefinition Width="Auto"/>
					    <ColumnDefinition Width="*"/>
				    </Grid.ColumnDefinitions>

				    <CheckBox x:Name="ChkAlienSLD" Grid.Column="0" 
						      Content="Отнес. на чужое СЛД"    
						      FontWeight="Bold"       
						      VerticalAlignment="Center"   
						      Checked="ChkAlienSLD_CheckedChanged"  
						      Unchecked="ChkAlienSLD_CheckedChanged"/>

					<TextBox x:Name="TxtAlienSLD" Grid.Column="1" 
						     Margin="10,0,0,0"  
						     VerticalAlignment="Center"  
						     Visibility="Collapsed"/>
				</Grid>
            </Border>
			

			<Grid Grid.Row="3" Margin="0,15,0,0">

                <Button Content="OK" 
                        Style="{StaticResource PopupStyleButton}"
                        Width="70"
                        IsDefault="True" 
                        Click="OkButton_Click" 
                        HorizontalAlignment="Left"
                        Name="OkButton"/>

               
                
                <Button Content="Отмена"
                        Style="{StaticResource PopupStyleButton}"
                        Width="70"
                        IsCancel="True" 
                        Click="CancelButton_Click" 
                        HorizontalAlignment="Right"/>
                
               
            </Grid>
        </Grid>
    </Border>
</Window>
