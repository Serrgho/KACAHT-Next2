<UserControl x:Class="Kas.SerLokPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d" 
             Width="620" Height="600"
             Loaded="UserControl_Loaded">

    <Border Background="{StaticResource AppBackBrush}"
            CornerRadius="4"
            BorderBrush="{StaticResource SplitterBrush}"
            BorderThickness="8">
        <Grid>
            <!-- Main content area -->
            <Grid x:Name="MainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Border Grid.Row="0"  Padding="10,5" CornerRadius="3,3,0,0">
					<StackPanel>
						<TextBlock Text="Укажите серию локомотива" 
									   FontWeight="Bold" HorizontalAlignment="Center" 
									   FontSize="14"/>
						<TextBlock Text="текущее значение:" 
								   FontWeight="SemiBold" FontStyle="Italic" HorizontalAlignment="Center" 
								   FontSize="12"/>
						<TextBlock Text="{Binding SerLokPripLokTXT, FallbackValue='***'}" 
								   FontWeight="Bold" TextAlignment="Center" FontSize="12"    
								   TextWrapping="Wrap"/>  
					</StackPanel> 
				</Border>

                <!-- TabControl с вкладками по типам тяги -->
                <TabControl x:Name="SeriesTabControl" Grid.Row="1"
                            Margin="5"
                            Background="Transparent"
                            ItemContainerStyle="{StaticResource TabItemRes}"
                            BorderThickness="1"
                            BorderBrush="Black"/>




                <!-- средняя панель с кнопками -->
                <Border Grid.Row="2"  Padding="2" CornerRadius="0,0,3,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Кнопка Удалить (только когда серия выбрана) -->
                        <Button x:Name="DeleteButton" Content="Удалить серию"
                                Style="{StaticResource PopupStyleButton}" 
                                Click="DeleteButton_Click" 
                                Margin="20 2"
                                Height="35"
                                Width="120"
                                Grid.Column="0"
                                IsEnabled="False"
                                HorizontalAlignment="Left" Cursor="Hand"/>

                        <!-- Кнопка добавления -->
                        <Button Content="Другая серия" 
                                Style="{StaticResource PopupStyleButton}" 
                                Click="CustomSeriesButton_Click" 
                                Margin="20 2"
                                Width="120"
                                Height="35"
                                Grid.Column="1"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </Border>


                <!-- Row 5: поле для номера локомотива -->
                <Border Grid.Row="3" Padding="5,2" Margin="2" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="№ локомотива:" VerticalAlignment="Center" Margin="5,0,0,0" TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1"
                  x:Name="NumLokTextBox" 
                  Margin="10,0,5,0" 
                  VerticalAlignment="Center" 
                  HorizontalAlignment="Stretch"
                  MaxLength="17"
                                 FontSize="25"
                  TextChanged="NumLokTextBox_TextChanged"
                  PreviewTextInput="NumLokTextBox_PreviewTextInput"/>
                    </Grid>
                </Border>


                <TabControl x:Name="AssignmentTabControl"
                            Grid.Row="4"
                            Margin="5"
                            Background="Transparent"
                            ItemContainerStyle="{StaticResource TabItemRes}"
                            BorderThickness="1"
                            BorderBrush="Black"/>
                
                
                <!-- Row 4: кнопки под приписками -->
                <Border Grid.Row="5" Padding="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DeleteAssignmentButton" 
                                Content="Удалить приписку"
                                Style="{StaticResource PopupStyleButton}" 
                                Click="DeleteAssignmentButton_Click"
                                IsEnabled="False"
                                Grid.Column="0"/>
                        
                        <Button Content="Новая приписка" 
                                Style="{StaticResource PopupStyleButton}" 
                                Click="CustomAssignmentButton_Click"
                                Grid.Column="1"/>
                    </Grid>
                </Border>




             

                <!-- Row 6: OK/Отмена -->
                <Border Grid.Row="6"  Padding="2" CornerRadius="0,0,3,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Кнопка OK -->
                        <Button x:Name="OkButton" Content="OK" 
                                Style="{StaticResource PopupStyleButton}" 
                                Click="OkButton_Click" 
                                Margin="20 2"
                                Width="120"
                                Height="35"
                                Grid.Column="0"
                                IsEnabled="False"
                                HorizontalAlignment="Left"/>

                        <!-- Кнопка Отмена -->
                        <Button Content="Отмена"
                                Style="{StaticResource PopupStyleButton}" 
                                Click="CancelButton_Click" 
                                Margin="20 2"
                                Width="120" 
                                Height="35"
                                Grid.Column="1"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

            </Grid>

            <!-- Контрол для ввода новой серии (изначально скрыт) -->
            <local:CustomSeriesInput x:Name="CustomSeriesInputControl" 
                                   Visibility="Collapsed"
                                  
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

            <!-- Контрол для ввода новой приписки -->
            <local:CustomPripisInput x:Name="CustomPripisInputControl" 
                          Visibility="Collapsed"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>

        </Grid>
    </Border>
</UserControl>
