<Window x:Class="Kas.FoundOtkazWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KACAHT_Next2.Kas"
        mc:Ignorable="d"
        Title="Найденные отказы"
        SizeToContent="WidthAndHeight"
        MaxHeight="600"
        MaxWidth="1200"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackBrush}">
	<Grid Margin="5">
		<DataGrid x:Name="dgFound"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#23FFFFFF"
                  FontSize="12"
                  FontFamily="Segoe UI"
                  BorderThickness="0"
                  SelectionUnit="Cell"
                  SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="False">

			<DataGrid.Resources>
							
				<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />

				<Style x:Key="BaseCellStyle" TargetType="DataGridCell">
					<Setter Property="Padding" Value="4,2"/>
					<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
					<Style.Triggers>
						<Trigger Property="IsSelected" Value="True">
							<Setter Property="Background" Value="{StaticResource SplitterBrush}"/>
							<Setter Property="Foreground" Value="{StaticResource AppBackBrush}"/>
							<Setter Property="FontWeight" Value="SemiBold" />
							<Setter Property="BorderBrush" Value="{StaticResource SplitterBrush}"/>
						</Trigger>
					</Style.Triggers>
				</Style>

				<Style TargetType="TextBlock" x:Key="CellWrapStyle">
					<Setter Property="TextWrapping" Value="Wrap"/>
					<Setter Property="VerticalAlignment" Value="Center"/>
					<Setter Property="HorizontalAlignment" Value="Stretch"/>
					<Setter Property="Padding" Value="4,2"/>
					<Setter Property="TextAlignment" Value="Center"/>
				</Style>

				<Style TargetType="TextBlock" x:Key="NoCellWrapStyle" BasedOn="{StaticResource CellWrapStyle}">
					<Setter Property="TextWrapping" Value="NoWrap"/>
				</Style>

				<Style TargetType="DataGridColumnHeader">
					<Setter Property="Padding" Value="4,2"/>
					<Setter Property="FontSize" Value="13"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
					<Setter Property="Background" Value="{StaticResource ScrolBarBrush}"/>
					<Setter Property="VerticalAlignment" Value="Center"/>
					<Setter Property="HorizontalContentAlignment" Value="Center"/>
				</Style>
			</DataGrid.Resources>

			<DataGrid.Columns>
				<DataGridTextColumn Header="Id"
                                    Binding="{Binding Id}"
                                    MinWidth="60" Width="0.9*"
                                    CellStyle="{StaticResource BaseCellStyle}"
                                    ElementStyle="{StaticResource NoCellWrapStyle}"/>

				<!--<DataGridTextColumn Header="Начало"
                                    Binding="{Binding Nach, StringFormat=dd.MM.yy HH:mm}"
                                    MinWidth="100" Width="1*"
                                    CellStyle="{StaticResource BaseCellStyle}"
                                    ElementStyle="{StaticResource CellWrapStyle}"/>-->
				<DataGridTemplateColumn Header="Начало"
                        MinWidth="80" Width="0.9*"
                        SortMemberPath="Nach"
                        ClipboardContentBinding="{Binding Nach}"
                        CellStyle="{StaticResource BaseCellStyle}">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
								<TextBlock Text="{Binding Nach, StringFormat=dd.MM.yy}"
                           HorizontalAlignment="Center"/>
								<TextBlock Text="{Binding Nach, StringFormat=HH:mm}"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTextColumn Header="Кто расследует"
                    Binding="{Binding KtoZakryl}"
                    MinWidth="100" Width="1*"
                    CellStyle="{StaticResource BaseCellStyle}"
                    ElementStyle="{StaticResource NoCellWrapStyle}"/>




				<DataGridTemplateColumn Header="Место отказа" Width="250" MinWidth="150" MaxWidth="400"
                        ClipboardContentBinding="{Binding MestoOTS_TXT}"
                        CellStyle="{StaticResource BaseCellStyle}">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<ContentControl Content="{Binding MestoOTS_TXT, Converter={StaticResource PlaceFormatterConverter}}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Padding="4,2" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>


				<DataGridTextColumn Header="Локомотив"
                                    Binding="{Binding SerLokPripLokTXT}"
                                    MinWidth="120" Width="1.5*" 
                                    CellStyle="{StaticResource BaseCellStyle}"
                                    ElementStyle="{StaticResource CellWrapStyle}"/>

				<DataGridTextColumn Header="Описание"
                                    Binding="{Binding Opis}"
                                    MinWidth="200" Width="3*"
                                    CellStyle="{StaticResource BaseCellStyle}"
                                    ElementStyle="{StaticResource CellWrapStyle}"/>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</Window>
