<UserControl x:Class="Kas.CustomSeriesInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400">
    <Border Background="{StaticResource AppBackBrush}" 
            BorderBrush="Gray"
            Margin="5"
            BorderThickness="1" 
            CornerRadius="4">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Text="Добавить новую серию" 
                      FontWeight="Bold" FontSize="14" 
                      HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Ввод серии -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,15">
                <TextBlock Text="Серия локомотива:" Margin="0,0,0,5"
                          FontWeight="SemiBold"/>
                <TextBox x:Name="SeriesTextBox" Height="30" FontSize="14"
                        TextChanged="SeriesTextBox_TextChanged"
                        Padding="5"/>
            </StackPanel>

            <!-- Тип тяги -->
            <TextBlock Grid.Row="2" Text="Тип подвижного состава:" 
                      Margin="0,0,0,5"
                      FontWeight="SemiBold"/>

            <!-- RadioButtons в WrapPanel -->
            <Border Grid.Row="3" BorderBrush="LightGray" BorderThickness="1"
                   CornerRadius="3" Margin="0,0,0,15" Padding="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="RadioButtonsPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <!-- Кнопки -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" 
                       HorizontalAlignment="Right" Margin="2 5">
                <Button x:Name="OkButton" Content="Добавить" 
                       Style="{StaticResource PopupStyleButton}"
                       Width="100" Height="35" Margin="0,0,10,0"
                       IsDefault="True" Click="OkButton_Click"/>
                <Button x:Name="CancelButton" Content="Отмена" 
                       Style="{StaticResource PopupStyleButton}"
                       Width="100" Height="35" 
                       IsCancel="True" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
