<UserControl x:Class="Kas.PeredachaPopupContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d" 
             Width="360" >
    <Border BorderBrush="{StaticResource SplitterBrush}" BorderThickness="4" Padding="3" Background="{StaticResource AppBackBrush}" CornerRadius=" 8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Передача отказа между предприятиями" FontWeight="Bold" HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,10"/>

            <!-- Две колонки -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Список ТЧЭ" FontWeight="SemiBold" FontSize="20" Foreground="DarkRed" Margin="2" HorizontalAlignment="Center"/>
                    <Button Content="ТЧЭ-1" Tag="ТЧЭ-1" Click="PredButton_Click" Style="{StaticResource PopupStyleButton}"/>
                    <Button Content="ТЧЭ-2" Tag="ТЧЭ-2" Click="PredButton_Click" Style="{StaticResource PopupStyleButton}"/>
                    <Button Content="ТЧЭ-3" Tag="ТЧЭ-3" Click="PredButton_Click" Style="{StaticResource PopupStyleButton}"/>
                    <Button Content="ТЧЭ-5" Tag="ТЧЭ-5" Click="PredButton_Click" Style="{StaticResource PopupStyleButton}"/>
                    <Button Content="ТЧЭ-7" Tag="ТЧЭ-7" Click="PredButton_Click" Style="{StaticResource PopupStyleButton}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Text="Список ТРПУ" FontWeight="SemiBold" FontSize="20" Foreground="DarkRed" Margin="2" HorizontalAlignment="Center"/>
                    <Button Content="ТРПУ-11" Tag="ТРПУ-11" Click="PredButton_Click" Style="{StaticResource PopupStyleButton}"/>
                    <Button Content="ТРПУ-4" Tag="ТРПУ-4" Click="PredButton_Click" Style="{StaticResource PopupStyleButton}"/>
                    <Button Content="ТРПУ-9" Tag="ТРПУ-9" Click="PredButton_Click" Style="{StaticResource PopupStyleButton}"/>
                    <Button Content="ТРПУ-12" Tag="ТРПУ-12" Click="PredButton_Click" Style="{StaticResource PopupStyleButton}"/>
                    <Button Content="ТРПУ-10" Tag="ТРПУ-10" Click="PredButton_Click" Style="{StaticResource PopupStyleButton}"/>
                </StackPanel>
            </Grid>

            <CheckBox Grid.Row="2" x:Name="HistoryCheckBox" Content="Добавить в историю" 
                      Margin="0,10,0,5" Checked="HistoryCheckBox_Toggled" Unchecked="HistoryCheckBox_Toggled"/>
			<!-- Меняем StackPanel на DockPanel -->
			<DockPanel x:Name="HistSP" Grid.Row="3" Visibility="Collapsed" LastChildFill="True">
				<DatePicker x:Name="DatePicker"
							DockPanel.Dock="Left"       
							VerticalContentAlignment="Stretch" 
							Background="Transparent"     
							SelectedDate="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=EventDate}"
							MinHeight="30"/>
				
				<TextBox x:Name="CommentBox" 
						 Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Comment}"
						 MinHeight="30"   
						 MinWidth="60"     
						 Background="Transparent" 
						 BorderBrush="{StaticResource SplitterBrush}"     
						 TextWrapping="Wrap"    
						 Margin="5,0,0,0"/>
			</DockPanel>
			
          	<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10">
                <Button Content="ОК" Click="OkButton_Click" Width="70"  Style="{StaticResource PopupStyleButton}"/>
                <Button Content="Отмена" Click="CancelButton_Click" Width="70" Style="{StaticResource PopupStyleButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
