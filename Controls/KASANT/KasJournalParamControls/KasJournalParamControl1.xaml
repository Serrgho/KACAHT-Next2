<UserControl x:Class="Kas.KasJournalParamControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d">
	<Grid Background="{StaticResource ScrolBarBrush}">
		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="auto"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="auto"/>
		</Grid.ColumnDefinitions>

		<Grid Grid.Column="0" Grid.Row="0" x:Name="BorderGrid">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="auto"/>
				<ColumnDefinition Width="auto"/>
			</Grid.ColumnDefinitions>
			<RadioButton  x:Name="But18" HorizontalAlignment="Center" Height="25" Checked="But18_Checked" Style="{StaticResource PopupStyleRadioButton}" Margin="2"  >18:00-18:00</RadioButton>
			<RadioButton Grid.Column="1"  x:Name="But23" HorizontalAlignment="Center" Height="25"  Checked="But23_Checked" IsChecked="True" Style="{StaticResource PopupStyleRadioButton}" Margin="2">00:00-23:59</RadioButton>

		</Grid>



		<Border Grid.Column="0" Grid.Row="1" Margin="2" HorizontalAlignment="Center" BorderThickness="1" CornerRadius="4" BorderBrush="{StaticResource SplitterBrush}" >
			<Border.Resources>
				<!-- Стиль для всех TextBox внутри этого StackPanel -->
				<Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
					<Setter Property="MinWidth" Value="28" />
					<Setter Property="BorderThickness" Value="0"/>
					<Setter Property="Background" Value="{ StaticResource ScrolBarBrush}"/>
					<Setter Property="FontSize" Value="15" />
					<Setter Property="FontWeight" Value="Bold" />
					<Setter Property="VerticalContentAlignment" Value="Center" />
					<Setter Property="TextAlignment"  Value="Center" />
					<Setter Property="HorizontalAlignment" Value="Center" />
					<Setter Property="Margin" Value="2" />
					<EventSetter Event="PreviewMouseLeftButtonDown" Handler="TextBox_SelectAll_OnPreviewMouseLeftButtonDown"/>
				</Style>
			</Border.Resources>
			<StackPanel  Orientation="Horizontal" Margin="2">

				<TextBlock Text="Руч. ввод времени: с" Margin="5 2 2 2" VerticalAlignment="Center" Foreground="Black" FontSize="15" />
				<TextBox x:Name="NHTBlock" Text="{Binding MWFetcher.NachTim,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" MinWidth="20" Foreground="DarkRed" BorderThickness="1" BorderBrush="{StaticResource SplitterBrush}" />
				<TextBlock Text="до" Margin="5 2 2 2" VerticalAlignment="Center" FontSize="15" Foreground="Black"/>
				<TextBox x:Name="KHTBlock" Text="{Binding MWFetcher.KonTim,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" MinWidth="20" Foreground="DarkRed" BorderThickness="1" BorderBrush="{StaticResource SplitterBrush}"/>

			</StackPanel>
		</Border>



	</Grid>
</UserControl>
