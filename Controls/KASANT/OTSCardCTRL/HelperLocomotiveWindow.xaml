<Window x:Class="Kas.HelperLocomotiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KACAHT_Next2.Kas"
         Title="Дача вспомогательного локомотива" 
        SizeToContent="Height" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
	<Border Padding="15" Background="{StaticResource AppBackBrush}">
		<StackPanel>
			<TextBlock Text="Дача вспомогательного локомотива" 
                       FontWeight="Bold" FontSize="14" Margin="0,0,0,15" 
                       HorizontalAlignment="Center"/>

			<TextBlock Text="Номер отказа:" Margin="0,0,0,5"/>
			<TextBox x:Name="txtViolId" IsReadOnly="True" Background="LightGray" Height="25"/>

			<TextBlock Text="№ поезда:" Margin="0,10,0,5"/>
			<TextBox x:Name="txtTrainNumber" Height="25"/>

			<TextBlock Text="№ и дата приказа в ДУ-58:" Margin="0,10,0,5"/>
			<TextBox x:Name="txtOrderInfo" Height="25" 
                     ToolTip="Например: №2444 от 18.09.26"/>

			<CheckBox x:Name="chkFollowWithHelper" Content="Следование со вспомогательным локомотивом" 
                      Margin="0,15,0,5" IsChecked="True"/>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
				<Button Content="Сохранить" Width="130" Height="30" 
                        Style="{StaticResource PopupStyleButton}" Click="BtnSave_Click" 
                        Margin="0,0,10,0" Foreground="DarkGreen" FontWeight="Bold"/>
				<Button Content="Отмена" Width="80" Height="30" 
                        Style="{StaticResource PopupStyleButton}" Click="BtnCancel_Click"/>
			</StackPanel>
		</StackPanel>
	</Border>
</Window>
