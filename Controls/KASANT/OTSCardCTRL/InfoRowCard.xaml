<UserControl x:Class="Kas.InfoRowCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d">

	<Border x:Name="RootBorder"
            Margin="0,2,0,2"
            Padding="4,2,4,2"
            CornerRadius="6"
            Background="Transparent"
            Cursor="Hand"
            
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave"
            MouseLeftButtonUp="RootBorder_MouseLeftButtonUp">

		<DockPanel LastChildFill="True">

			<!-- ЛЕВАЯ ЧАСТЬ — КЛЮЧ -->
			<TextBlock x:Name="tbKey"
                       DockPanel.Dock="Left"
                       Width="400"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="DimGray"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"/>

			<!-- ПРАВАЯ ЧАСТЬ — ЗНАЧЕНИЕ -->
			<TextBlock x:Name="tbValue"
                       FontSize="12"
                       FontWeight="Normal"
                       Foreground="Black"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Margin="15,0,0,0"/>

		</DockPanel>
	</Border>
</UserControl>
