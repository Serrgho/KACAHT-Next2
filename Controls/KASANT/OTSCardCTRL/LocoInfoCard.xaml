<UserControl x:Class="Kas.LocoInfoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

	<!-- Основной Border с кликабельным фоном -->
	<Border x:Name="RootBorder"
            BorderBrush="DarkBlue" BorderThickness="0.5"
            Padding="10" Margin="30,5" CornerRadius="5"
            
            MouseLeftButtonUp="RootBorder_MouseLeftButtonUp">
			<!--Background="Transparent"-->
		<Border.Style>
			<Style TargetType="Border">
				<Setter Property="Background" Value="Transparent"/>
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<!-- #AARRGGBB | 25 = ~15% прозрачности чёрного. Меняй первые 2 цифры: 10 (светлее) → 40 (темнее) -->
						<Setter Property="Background" Value="#25000000"/>
					</Trigger>
				</Style.Triggers>
			</Style>
		</Border.Style>
		

		<StackPanel x:Name="spContent">
			<StackPanel.Resources>
				<Style TargetType="RichTextBox">
					<Setter Property="IsReadOnly" Value="True"/>
					<Setter Property="Focusable" Value="False"/>
					<Setter Property="IsHitTestVisible" Value="False"/>
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="BorderThickness" Value="0"/>
					<Setter Property="Margin" Value="1"/>
					<Setter Property="Padding" Value="0"/>
					<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
					<Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
				</Style>
			</StackPanel.Resources>
			<!-- 1. Серия и номер -->
			<RichTextBox x:Name="rtbSeries" Focusable="False" IsReadOnly="True" IsDocumentEnabled="True" IsReadOnlyCaretVisible="False" 
                         Background="Transparent" BorderThickness="0" Margin="1" Padding="0" 
                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                         FontSize="12" FontWeight="SemiBold" Foreground="DarkRed" Visibility="Collapsed">
				<FlowDocument PagePadding="0" LineHeight="1">
					<Paragraph Margin="0">
						<Run x:Name="runSeries"/>
					</Paragraph>
				</FlowDocument>
			</RichTextBox>

			<!-- 2. Приписка локомотива -->
			<RichTextBox x:Name="rtbLocoAttach" Focusable="False" IsReadOnly="True" IsDocumentEnabled="True" IsReadOnlyCaretVisible="False" 
                         Background="Transparent" BorderThickness="0" Margin="1" Padding="0" 
                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                         FontSize="12" Visibility="Collapsed">
				<FlowDocument PagePadding="0" LineHeight="1">
					<Paragraph Margin="0">
						<Run x:Name="runLocoAttachHeader" FontWeight="Bold"/>
						<Run x:Name="runLocoAttachText"/>
					</Paragraph>
				</FlowDocument>
			</RichTextBox>

			<!-- 3. Машинист -->
			<RichTextBox x:Name="rtbDriver" Focusable="False" IsReadOnly="True" IsDocumentEnabled="True" IsReadOnlyCaretVisible="False" 
                         Background="Transparent" BorderThickness="0" Margin="1" Padding="0" 
                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                         FontSize="12" FontWeight="SemiBold" Foreground="DarkRed" Visibility="Collapsed">
				<FlowDocument PagePadding="0" LineHeight="1">
					<Paragraph Margin="0">
						<Run x:Name="runDriverHeader" FontWeight="Bold"/>
						<Run x:Name="runDriverText"/>
					</Paragraph>
				</FlowDocument>
			</RichTextBox>

			<!-- 4. Приписка бригады -->
			<RichTextBox x:Name="rtbCrewAttach" Focusable="False" IsReadOnly="True" IsDocumentEnabled="True" IsReadOnlyCaretVisible="False" 
                         Background="Transparent" BorderThickness="0" Margin="1" Padding="0" 
                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                         FontSize="12" Visibility="Collapsed">
				<FlowDocument PagePadding="0" LineHeight="1">
					<Paragraph Margin="0">
						<Run x:Name="runCrewAttachHeader" FontWeight="Bold"/>
						<Run x:Name="runCrewAttachText"/>
					</Paragraph>
				</FlowDocument>
			</RichTextBox>
		</StackPanel>
	</Border>
</UserControl>
