<UserControl x:Class="Kas.DocumentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="400">
	<Border x:Name="RootBorder"
            
            Margin="2 1" Padding="2" CornerRadius="8"
            Background="{DynamicResource ScrolBarBrush}">
		<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
			
		<StackPanel Margin="0">
			
				<!-- Кликабельная ссылка на файл -->
					<TextBlock x:Name="FileLink"
							TextWrapping="Wrap"
							Cursor="Hand"
							FontSize="14"
							Margin="4,1,1,2"
							Padding="1"
							ToolTip="Нажмите для скачивания и открытия">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Style.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter Property="Effect">
											<Setter.Value>
												<DropShadowEffect BlurRadius="4"  
																	ShadowDepth="2" 
																	Direction="270" 	 
																	Color="{StaticResource SplitterColor}" 
																	Opacity="0.9"/>
											</Setter.Value>
										</Setter>
									</Trigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
				</TextBlock>
				
			
			

			<!-- Кто загрузил (скрыт по умолчанию) -->
			<TextBlock x:Name="UploaderText"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="Black"
                       Margin="4,1,1,2"
                       Visibility="Collapsed"/>

			<!-- Комментарий (скрыт по умолчанию) -->
			<TextBlock x:Name="CommentText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       FontStyle="Italic"
					   FontWeight="SemiBold"
                       Foreground="DarkGreen"
                       Margin="4,1,1,2"
                       Visibility="Collapsed"/>

		</StackPanel>
			<Image Grid.Column="1"
				   x:Name="FileIcon"
				   Stretch="Uniform" 
				   MaxHeight="45" 
				   HorizontalAlignment="Center"	 
				   VerticalAlignment="Center"
				   Source="/Icons/deflt.png" />
		</Grid>
	</Border>
</UserControl>
