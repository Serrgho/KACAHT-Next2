<Window x:Class="Kas.KasAntWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KACAHT_Next2.Kas"
        mc:Ignorable="d"
		Closed="Window_Closed"
		Title="КАСАНТ - Карточка отказа"
		SizeToContent="Height">

	<Border Padding="10" Background="{StaticResource AppBackBrush}">
		
		<Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
				<RowDefinition  MaxHeight="400"/>
				<RowDefinition  MaxHeight="800"/>
        </Grid.RowDefinitions>
		
		<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2">  
			<Border BorderThickness="2" BorderBrush="{StaticResource ScrolBarBrush}" CornerRadius="4">
					<StackPanel Orientation="Horizontal" Margin="2">
						<Button x:Name="btnLoad" Content="🔄️" Style="{StaticResource PopupStyleButton}" Height="30" FontSize="20" Padding="0" Foreground="DarkGreen" FontWeight="Bold" ToolTip="Обновить" Margin="2" Click="btnLoad_Click"/>
						<TextBlock  Text="Номер отказа:" VerticalAlignment="Center" Margin="10,0"/>
						<TextBox x:Name="txtViolId" Width="150" VerticalContentAlignment="Center" FontSize="18" Background="{StaticResource AppBackBrush}"/>
						<TextBlock Text="код дороги:" VerticalAlignment="Center" Margin="20,0,10,0" />
						<TextBox x:Name="txtDorKod" Width="50" VerticalContentAlignment="Center" FontSize="18" Background="{StaticResource AppBackBrush}"/>
					</StackPanel>
				</Border>
				
				<!-- === НОВЫЕ ЭЛЕМЕНТЫ ДЛЯ НАЗНАЧЕНИЯ === -->
				<Border BorderThickness="2" BorderBrush="{StaticResource ScrolBarBrush}" CornerRadius="4" Margin="5,0,0,0">
					<StackPanel Orientation="Horizontal" Margin="2">
						  <Button x:Name="btnDelegate" 
                        Content="🛠️⬇️" 
                        Style="{StaticResource PopupStyleButton}" 
                        Height="30"
						FontSize="20" Padding="0"
                         
                        Foreground="DarkBlue"
                        FontWeight="Bold"
                        ToolTip="Передать выбранный отказ в указанное депо"
                        Click="btnDelegate_Click"/>

				<ComboBox x:Name="cmbDepots" 
                          Style="{StaticResource MyCombo}"
                          Width="80" 
                          Margin="5,0,0,0" 
                          VerticalContentAlignment="Center"
                          DisplayMemberPath="Name"	
                          SelectedValuePath="Id"
                          ToolTip="Выберите депо для назначения отказа"/>
					</StackPanel>
				</Border>
				

				
				<!-- ======================================= -->

				<Button x:Name="btnTestFile" Content="📁 Тест из файла" Style="{StaticResource PopupStyleButton}" Height="30" Margin="10,0,0,0" Click="btnTestFile_Click"/>

			</StackPanel>

       
        <TextBlock x:Name="lblStatus" Grid.Row="2" Text="" 
                   Foreground="Gray" Margin="0,0,0,10"/>

			<StackPanel x:Name="HeaderSPan" Grid.Row="3" />

			<!-- Результаты -->
		<Grid Grid.Row="4" Margin="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<!-- Место отказа -->
				<ColumnDefinition Width="480"/>
				<!-- Поезда: занимает остаток -->
			</Grid.ColumnDefinitions>

			<!-- Место отказа -->
				<!--<GroupBox Grid.Column="0" Header="Параметры отказа" Margin="2" Background="Transparent">-->
				<Border Grid.Column="0" BorderBrush="{StaticResource SplitterBrush}" BorderThickness="0.5" Padding="5">
						<ScrollViewer VerticalScrollBarVisibility="Auto" > 
							<ScrollViewer.Resources>  
								<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />
							</ScrollViewer.Resources>  
							<StackPanel x:Name="MestoSP"/>
						</ScrollViewer>	
				</Border>		
			
				<!--</GroupBox>-->

			<!-- Задержанные поезда -->
				<!--GroupBox Grid.Column="1" Header="Задержанные поезда" Margin="2" Padding="5" Background="Transparent">-->
				<Border Grid.Column="1" BorderBrush="{StaticResource SplitterBrush}" BorderThickness="0.5" Padding="2">
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="auto" MaxHeight="300" >
					<ScrollViewer.Resources>
						<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />
					</ScrollViewer.Resources>
					<StackPanel x:Name="pnlTrainInfo" />
				</ScrollViewer>
				</Border>
				
			<!--</GroupBox>-->
		</Grid>

		<Grid Grid.Row="5" Margin="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<!-- История отказа -->
				<ColumnDefinition Width="500"/>
				<!-- Документы: занимает остаток -->
			</Grid.ColumnDefinitions>

				<!--<GroupBox Grid.Column="0" Header="История отказа" Padding="5" Background="Transparent">-->
				<Border Grid.Column="0" BorderBrush="{StaticResource SplitterBrush}" BorderThickness="0.5" Padding="2">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<!-- Для заголовка -->
							<RowDefinition Height="*"/>
							<!-- Для скролла (занимает всё остальное) -->
						</Grid.RowDefinitions>
						<Label Grid.Row="0" Content="История отказа" Margin="0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AppBackBrush}" Background="{StaticResource SplitterBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Stretch"/>
						<ScrollViewer Grid.Row="1" x:Name="HistScroller" VerticalScrollBarVisibility="Auto" Height="auto" MaxHeight="800">
							<ScrollViewer.Resources>
								<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />
							</ScrollViewer.Resources>
							<StackPanel x:Name="HistSP" />
						</ScrollViewer>

					</Grid>

					
				</Border>
				
				<!--</GroupBox>-->
				<!--<GroupBox Grid.Column="1" Header="Документы по отказу" Background="Transparent">-->
				<Border Grid.Column="1" BorderBrush="{StaticResource SplitterBrush}" BorderThickness="0.5" Padding="2">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<!-- Для заголовка -->
							<RowDefinition Height="*"/>
							<!-- Для скролла (занимает всё остальное) -->
						</Grid.RowDefinitions>
							  <Label Grid.Row="0" Content="Документы по отказу" Margin="0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AppBackBrush}" Background="{StaticResource SplitterBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Stretch"/>
						<ScrollViewer Grid.Row="1" x:Name="DocScroll" VerticalScrollBarVisibility="Auto">
							<ScrollViewer.Resources>   
								<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" /> 
							</ScrollViewer.Resources> 
							<StackPanel x:Name="DocsSP"/>  
						</ScrollViewer>

						</Grid>
						
					
					
				</Border>
				
			<!--</GroupBox>-->
		</Grid>
	</Grid>

    
	</Border>
</Window>
