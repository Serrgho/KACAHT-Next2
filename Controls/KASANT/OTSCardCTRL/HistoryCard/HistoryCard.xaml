<Border x:Class="Kas.HistoryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d" 
             Margin="2,1,2,1" Padding="3,2,3,2" CornerRadius="8"
		Background="{StaticResource ScrolBarBrush}">
	
	<!-- Фоллбэк, если ресурс не найден -->
	<Border.Resources>
		<SolidColorBrush x:Key="ScrolBarBrush" Color="#FAFAFA"/>
	</Border.Resources>

	<StackPanel x:Name="RootPanel">
		<!-- Номер ОТС -->
		<TextBlock x:Name="tbAlienNum"
                   Margin="0" Padding="3,1"
                   Foreground="Firebrick" FontSize="15" FontWeight="DemiBold"
                   LineHeight="18" LineStackingStrategy="BlockLineHeight"
                   Cursor="Hand" Background="Transparent"
                   Visibility="Collapsed"
                   MouseLeftButtonUp="OnCopyClick2">
			<TextBlock.Style>
				<Style TargetType="TextBlock">
					<Style.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Effect">
								<Setter.Value>
									<DropShadowEffect BlurRadius="4"  
													  ShadowDepth="2" 
													  Direction="270" 	 
													  Color="{StaticResource SplitterColor}" 
													  Opacity="0.9"/>
								</Setter.Value>
							</Setter>
						</Trigger>
					</Style.Triggers>
				</Style>
			</TextBlock.Style>

		</TextBlock>

		<!-- Кто завёл/передал -->
		<TextBlock x:Name="tbByWhom"
                   Margin="4,0,1,0" Foreground="Black" FontSize="12"
                   Visibility="Collapsed"/>

		<!-- Основная строка с Inlines -->
		<TextBlock x:Name="tbMain"
                   Margin="0,1,0,0" FontSize="14"
                   LineHeight="17" LineStackingStrategy="BlockLineHeight"
                   TextWrapping="Wrap"
                   Cursor="Hand" Background="Transparent" Padding="4,1,4,1"
                   MouseLeftButtonUp="OnCopyClick">
			<TextBlock.Style>
				<Style TargetType="TextBlock">
					<Style.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Effect">
								<Setter.Value>
									<DropShadowEffect BlurRadius="4"  
													  ShadowDepth="2" 
													  Direction="270" 	 
													  Color="{StaticResource SplitterColor}" 
													  Opacity="0.9"/>
								</Setter.Value>
							</Setter>
						</Trigger>
					</Style.Triggers>
				</Style>
			</TextBlock.Style>
		</TextBlock>
	</StackPanel>
</Border>
