<UserControl x:Class="Kas.CommentCopyPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
			 d:DesignWidth="120" d:DesignHeight="50"
			 Background="Transparent"
            mc:Ignorable="d" x:Name="Root">


	<UserControl.Resources>
		<!-- Стиль для кликабельных TextBlock с врапом и ховером -->
		<Style x:Key="PopupItemStyle" TargetType="TextBlock">
			<Setter Property="Padding" Value="4"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="TextAlignment" Value="Left"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Background" Value="Transparent"/>
			<!-- Важно: ограничиваем ширину, иначе TextWrap не сработает внутри StackPanel -->
			<Setter Property="MaxWidth" Value="420"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{StaticResource ScrolBarBrush}"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<Popup x:Name="MainPopup" StaysOpen="False" AllowsTransparency="True"
           Placement="Bottom" VerticalOffset="8" PopupAnimation="Fade">

		<Border Grid.Row="0" Background="{StaticResource AppBackBrush}" CornerRadius="8" BorderBrush="{StaticResource SplitterBrush}"	BorderThickness="3" Padding="2" Width="450" MaxHeight="700">
			   <Border.Effect>
				   <DropShadowEffect BlurRadius="12" ShadowDepth="4" Color="#33000000" Direction="315"/>
			   </Border.Effect>
			   <Grid>
				   <Grid.RowDefinitions>
					   <RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					   <RowDefinition Height="Auto" />
					   <RowDefinition Height="*"/>
					   <RowDefinition Height="Auto" />
				   </Grid.RowDefinitions>
				   <TextBlock x:Name="BtnCopyAsIs" Style="{StaticResource PopupItemStyle}" 
							   Text="📋 Копировать как есть" FontWeight="SemiBold" FontSize="13" 
							   MouseLeftButtonUp="BtnCopyAsIs_Click"/>
				<Separator Grid.Row="1"/>
						
						<!-- Шаблоны -->
							<StackPanel Grid.Row="2" x:Name="PresetStack"/>
				<Separator Grid.Row="3" x:Name="DynSeparator" Visibility="Collapsed"/>

				<TextBlock Grid.Row="4" x:Name="HistoryHeader" Text="🔁 Из истории:" Foreground="Blue" FontSize="12"
							   Padding="12,4" Visibility="Collapsed"/>


				<ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" 
               HorizontalScrollBarVisibility="Disabled">
					<ScrollViewer.Resources>
						<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />
					</ScrollViewer.Resources>
					<StackPanel x:Name="HistoryStack"/>
				</ScrollViewer>





				<Border Grid.Row="6" Background="{StaticResource ScrolBarBrush}" Height="70" Padding="12,6" CornerRadius="0,0,8,8">
							<TextBlock x:Name="PreviewText" Text="Загрузка..."
								   Foreground="Black" FontStyle="Italic" FontWeight="DemiBold" FontSize="12"
								   TextWrapping="Wrap" 
								   VerticalAlignment="Center"/>
						</Border>
					 </Grid>
					</Border>
	</Popup>

	
</UserControl>
