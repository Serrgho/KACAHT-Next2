<UserControl x:Class="Kas.JournalViewerRestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1250">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- 📊 Панель статистики -->
		<Border Grid.Row="0" Margin="5,5,5,2" Padding="8,4" Background="#14000000">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock x:Name="txtStats" Grid.Column="0" 
                          FontSize="13" FontWeight="SemiBold" 
                          Foreground="DarkSlateGray" VerticalAlignment="Center"/>
				<Button Grid.Column="1" x:Name="btnRefresh" 
                        Content="🔄 Обновить" 
                        Margin="10,0,0,0" Padding="8,2"
                        Click="BtnRefresh_Click"/>
			</Grid>
		</Border>

		<!-- 📋 Таблица -->
		<DataGrid x:Name="dgJournal" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#23FFFFFF"
                  FontSize="12"
                  FontFamily="Segoe UI"
                  BorderThickness="0"
                  Margin="5,0,5,5"
                  SelectionUnit="Cell"
                  SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="False"
                  MouseDoubleClick="DgJournal_MouseDoubleClick"
                  PreviewKeyDown="DgJournal_PreviewKeyDown">

			<DataGrid.Resources>
				
				<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />
				
				<!-- 🔹 Базовый стиль ячейки -->
				<Style x:Key="BaseCellStyle" TargetType="DataGridCell">
					<Setter Property="Padding" Value="4,2"/>
					<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
					<Style.Triggers>
						<Trigger Property="IsSelected" Value="True">
							<Setter Property="Background" Value="{StaticResource SplitterBrush}"/>
							<Setter Property="Foreground" Value="{StaticResource AppBackBrush}"/>
							<Setter Property="FontWeight" Value="SemiBold"/>
							<Setter Property="BorderBrush" Value="{StaticResource SplitterBrush}"/>
						</Trigger>
					</Style.Triggers>
				</Style>

				<!-- 🔹 Перенос текста -->
				<Style TargetType="TextBlock" x:Key="CellWrapStyle">
					<Setter Property="TextWrapping" Value="Wrap"/>
					<Setter Property="VerticalAlignment" Value="Center"/>
					<Setter Property="HorizontalAlignment" Value="Stretch"/>
					<Setter Property="Padding" Value="4,2"/>
					<Setter Property="TextAlignment" Value="Left"/>
				</Style>

				<!-- 🔹 Glow-эффект для кликабельных ячеек -->
				<Style x:Key="TextGlowStyle" TargetType="TextBlock" BasedOn="{StaticResource CellWrapStyle}">
					<Setter Property="TextAlignment" Value="Center"/>
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
							<Setter Property="Cursor" Value="Hand"/>
							<Setter Property="Effect">
								<Setter.Value>
									<DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="270" 
                                                      Color="{StaticResource SplitterColor}" Opacity="0.9"/>
								</Setter.Value>
							</Setter>
							<Setter Property="FontWeight" Value="SemiBold"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>

				<!-- 🔹 Заголовки -->
				<Style TargetType="DataGridColumnHeader">
					<Setter Property="Padding" Value="4,2"/>
					<Setter Property="FontSize" Value="13"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
					<Setter Property="Background" Value="{StaticResource ScrolBarBrush}"/>
					<Setter Property="VerticalAlignment" Value="Center"/>
					<Setter Property="HorizontalContentAlignment" Value="Center"/>
				</Style>
			</DataGrid.Resources>

			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Header="📋 Копировать выделенное" Click="MenuItem_Copy_Click"/>
				</ContextMenu>
			</DataGrid.ContextMenu>

			<DataGrid.Columns>
				<DataGridTextColumn Header="№" Binding="{Binding ViolId}" Width="0.55*" 
                                   CellStyle="{StaticResource BaseCellStyle}" ElementStyle="{StaticResource TextGlowStyle}"/>
				<DataGridTextColumn Header="Кат." Binding="{Binding Category}" Width="0.5*" 
                                   CellStyle="{StaticResource BaseCellStyle}" ElementStyle="{StaticResource CellWrapStyle}"/>
				<DataGridTextColumn Header="Начало" Binding="{Binding DateFrom}" Width="0.7*" 
                                   CellStyle="{StaticResource BaseCellStyle}" ElementStyle="{StaticResource CellWrapStyle}"/>
				<DataGridTextColumn Header="Окончание" Binding="{Binding DateTo}" Width="0.7*" 
                                   CellStyle="{StaticResource BaseCellStyle}" ElementStyle="{StaticResource CellWrapStyle}"/>
				<!--<DataGridTextColumn Header="Место" Binding="{Binding PlaceInfo}" Width="1.3*" 
                                   CellStyle="{StaticResource BaseCellStyle}" ElementStyle="{StaticResource CellWrapStyle}"/>-->
				<!-- 2. Замените старую колонку на эту: -->
				<DataGridTemplateColumn Header="Место" Width="1.3*" CellStyle="{StaticResource BaseCellStyle}">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<!-- ContentControl корректно отображает UIElement, возвращённый конвертером -->
							<ContentControl Content="{Binding PlaceInfo, Converter={StaticResource PlaceFormatterConverter}}" 
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Padding="0"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn Header="Расследование" Binding="{Binding Investigation}" Width="0.9*" 
                                   CellStyle="{StaticResource BaseCellStyle}" ElementStyle="{StaticResource CellWrapStyle}"/>
				<DataGridTextColumn Header="Виновный" Binding="{Binding Guilty}" Width="1.2*" 
                                   CellStyle="{StaticResource BaseCellStyle}" ElementStyle="{StaticResource CellWrapStyle}"/>
				<DataGridTextColumn Header="Поезда" Binding="{Binding Train}" Width="1.5*" 
                                   CellStyle="{StaticResource BaseCellStyle}" ElementStyle="{StaticResource CellWrapStyle}"/>
				<DataGridTextColumn Header="Тех. средство" Binding="{Binding ReasonObjectTop}" Width="1.4*" 
                                   CellStyle="{StaticResource BaseCellStyle}" ElementStyle="{StaticResource CellWrapStyle}"/>
				<DataGridTextColumn Header="Группа причин" Binding="{Binding GroupReason}" Width="1.4*" 
                                   CellStyle="{StaticResource BaseCellStyle}" ElementStyle="{StaticResource CellWrapStyle}"/>
				<DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="2*" 
                                   CellStyle="{StaticResource BaseCellStyle}" ElementStyle="{StaticResource CellWrapStyle}"/>
			</DataGrid.Columns>
		</DataGrid>

		<!-- 🔄 Индикатор загрузки -->
		<Grid x:Name="grdLoading" Grid.Row="1" Background="#80FFFFFF" Visibility="Collapsed">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
				<ProgressBar IsIndeterminate="True" Width="200" Height="20" Margin="0,0,0,10"/>
				<TextBlock x:Name="txtLoading" Text="Загрузка..." HorizontalAlignment="Center" FontWeight="SemiBold"/>
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
