<UserControl x:Class="Kas.DepotReportViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace.Kas"
             mc:Ignorable="d">
	

	<UserControl.Resources>
		 <!--Стиль для колонки "Депо" (выравнивание по левому краю)--> 
		<Style x:Key="DepotCellStyle" TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="6,2,4,2"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		 <!--Стиль для числовых колонок (выравнивание по центру)--> 
		<Style x:Key="NumericCellStyle" TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="4,2"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

		 <!--Конвертер bool → Visibility для условного отображения колонок периода 2--> 
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
	</UserControl.Resources>

	<Grid Background="{StaticResource AppBackBrush}" HorizontalAlignment="Left" Width="Auto">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		 <!--📊 Заголовок / Статистика--> 
		<!--<Border Grid.Row="0" Margin="5,5,5,2" Padding="8,4" >
			<TextBlock x:Name="txtStats" FontSize="13" FontWeight="SemiBold" 
                       Foreground="DarkSlateGray" VerticalAlignment="Center"/>
		</Border>-->

		 <!--📋 Таблица--> 
		<DataGrid x:Name="dgReport" Grid.Row="1"
				  SelectionUnit="Cell"
				  SelectionMode="Extended"
				  HorizontalAlignment="Left"   
				  Width="Auto"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#D7DEA9"
                  FontSize="12"
                  FontFamily="Segoe UI"
                  BorderThickness="0"
                  Margin="5,0,5,5"
                  HeadersVisibility="Column"
                  LoadingRow="dgReport_LoadingRow">

			<DataGrid.Resources>
				<Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBarStyle}" />

				<Style TargetType="DataGridCell">
					<Setter Property="Padding" Value="4,2"/>
					<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
					<Style.Triggers>
						<Trigger Property="IsSelected" Value="True">
							<Setter Property="Background" Value="{StaticResource SplitterBrush}"/>
							<Setter Property="Foreground" Value="{StaticResource AppBackBrush}"/>
							<Setter Property="FontWeight" Value="SemiBold"/>
						</Trigger>
					</Style.Triggers>
				</Style>

				<Style TargetType="TextBlock">
					<Setter Property="TextWrapping" Value="Wrap"/>
					<Setter Property="VerticalAlignment" Value="Center"/>
					<Setter Property="HorizontalAlignment" Value="Center"/>
					<Setter Property="Padding" Value="4,2"/>
				</Style>

				<Style TargetType="DataGridColumnHeader">
					<Setter Property="Padding" Value="6,4"/>
					<Setter Property="FontSize" Value="13"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
					<Setter Property="Background" Value="{StaticResource ScrolBarBrush}"/>
					<Setter Property="VerticalAlignment" Value="Center"/>
					<Setter Property="HorizontalContentAlignment" Value="Center"/>
					<Setter Property="BorderBrush" Value="{StaticResource ScrolBarBrush}"/>
					<Setter Property="BorderThickness" Value="0,0,1,1"/>
				</Style>
			</DataGrid.Resources>

			<DataGrid.Columns>
				 <!--1. Депо--> 
				<DataGridTextColumn Binding="{Binding DepotName}"
									Width="Auto"   
									IsReadOnly="True"	  
									ElementStyle="{StaticResource DepotCellStyle}">	
					<DataGridTextColumn.Header>	
						<TextBlock Text="Депо"
								   TextAlignment="Left"		
								   VerticalAlignment="Center"	 
								   Margin="4,2"/>	
					</DataGridTextColumn.Header>  
				</DataGridTextColumn>

				 <!--2. Период 1 — текущий год--> 
				<DataGridTextColumn Binding="{Binding Period1Current, TargetNullValue=''}"
									MinWidth="70"
                                    Width="Auto"
                                    ElementStyle="{StaticResource NumericCellStyle}">
					<DataGridTextColumn.Header>
						<TextBlock Text="{Binding Period1CurrentHeader, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="4,2"/>
					</DataGridTextColumn.Header>
				</DataGridTextColumn>

				 <!--3. Период 1 — прошлый год--> 
				<DataGridTextColumn Binding="{Binding Period1PrevYear, TargetNullValue=''}"
                                    MinWidth="70" 
									Width="Auto"
                                    ElementStyle="{StaticResource NumericCellStyle}">
					<DataGridTextColumn.Header>
						<TextBlock Text="{Binding Period1PrevYearHeader, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   HorizontalAlignment="Stretch"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="4,2"/>
					</DataGridTextColumn.Header>
				</DataGridTextColumn>

				 <!--4. Период 2 — текущий год (скрывается, если периода 2 нет)--> 
				<DataGridTextColumn Binding="{Binding Period2Current, TargetNullValue=''}"
                                    MinWidth="70"
									Width="Auto"
                                    ElementStyle="{StaticResource NumericCellStyle}"
                                    Visibility="{Binding HasPeriod2, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
					<DataGridTextColumn.Header>
						<TextBlock Text="{Binding Period2CurrentHeader, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   HorizontalAlignment="Stretch"
								   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="4,2"/>
					</DataGridTextColumn.Header>
				</DataGridTextColumn>

				 <!--5. Период 2 — прошлый год (скрывается, если периода 2 нет)--> 
				<DataGridTextColumn Binding="{Binding Period2PrevYear, TargetNullValue=''}"
                                    MinWidth="70"
									Width="Auto"   									
                                    ElementStyle="{StaticResource NumericCellStyle}"
                                    Visibility="{Binding HasPeriod2, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
					<DataGridTextColumn.Header>
						<TextBlock Text="{Binding Period2PrevYearHeader, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   HorizontalAlignment="Stretch"
								   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="4,2"/>
					</DataGridTextColumn.Header>
				</DataGridTextColumn>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>



