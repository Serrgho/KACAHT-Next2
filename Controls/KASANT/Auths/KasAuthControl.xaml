<UserControl x:Class="Kas.KasAuthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KACAHT_Next2.Kas"
			 Background="{StaticResource AppBackBrush}"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="300">
	<UserControl.Resources>
		<Style x:Key="DarkGreenTextBox" TargetType="TextBox">
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="FontWeight" Value="Normal"/>
			<Setter Property="Height" Value="25"/>
			<Setter Property="Margin" Value="5,0,5,5"/>
			<Setter Property="Padding" Value="3"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="Bd" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"
                            CornerRadius="2">
							<ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
						</Border>
						<ControlTemplate.Triggers>
							<!-- Наведение мыши -->
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="DarkGreen"/>
							</Trigger>
							<!-- Фокус ввода -->
							<Trigger Property="IsFocused" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="DarkBlue"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DarkGreenPasswordBox" TargetType="PasswordBox">
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="FontWeight" Value="Normal"/>
			<Setter Property="Height" Value="25"/>
			<Setter Property="Margin" Value="5,0,5,5"/>
			<Setter Property="Padding" Value="3"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="PasswordBox">
						<Border x:Name="MainBorder" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True"
                        CornerRadius="2">
							<ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
						</Border>
						<ControlTemplate.Triggers>
							<!-- Наведение мыши -->
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MainBorder" Property="BorderBrush" Value="DarkGreen"/>
							</Trigger>
							<!-- Фокус ввода -->
							<Trigger Property="IsFocused" Value="True">
								<Setter TargetName="MainBorder" Property="BorderBrush" Value="DarkBlue"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DarkGreenCheckBox" TargetType="CheckBox">
			<Setter Property="Foreground" Value="DarkGreen"/>
			<Setter Property="FontWeight" Value="Normal"/>
			<Setter Property="Margin" Value="10 5 5 5"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Template"> 
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<!-- BulletDecorator автоматически выравнивает квадратик и текст -->
						<BulletDecorator Background="Transparent" Cursor="Hand">
							<BulletDecorator.Bullet>
								<Border x:Name="CheckBoxBorder" 
                                Width="16" Height="16" 
                                BorderBrush="DarkGreen" 
                                BorderThickness="2" 
                                Background="Transparent"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
									<!-- Галочка -->
									<Path x:Name="CheckMark" 
                                  Data="M 1 5 L 4 8 L 9 2" 
                                  Stroke="DarkBlue" 
                                  StrokeThickness="2" 
                                  Visibility="Collapsed" 
                                  Stretch="None"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
								</Border>
							</BulletDecorator.Bullet>
							<!-- Текст (обязателен для отображения Content!) -->
							<ContentPresenter Margin="6,0,0,0" 
                                      VerticalAlignment="Center" 
                                      RecognizesAccessKey="True"/>
						</BulletDecorator>

						<ControlTemplate.Triggers>
							<!-- ✅ Отмечено -->
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
								<Setter Property="Foreground" Value="DarkBlue"/>
								<Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="DarkBlue"/>
							</Trigger>
							<!-- ✅ Наведение мыши -->
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="DarkGreen"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</UserControl.Resources>
	
	<Expander x:Name="expAuth" 
              Header="👤 Авторизация в КАСАНТ" 
              Background="{StaticResource ScrolBarBrush}"
			  FontSize="15"
              FontWeight="Bold"
              BorderThickness="3"
              BorderBrush="{StaticResource SplitterBrush}"
              IsExpanded="True"
              HorizontalContentAlignment="Stretch">

		<GroupBox Header="" FontWeight="Bold" Margin="2" Background="Transparent" BorderThickness="0">
			<StackPanel>

				<!-- 🔹 Блок 1: Дорожный логин (основной ферчер) -->
				<TextBlock Text="📍 Дорожный логин:" FontWeight="Normal" Margin="0,0,0,5" Foreground="DarkBlue"/>
				<!--BorderBrush="{StaticResource SplitterBrush}"-->
				<TextBlock Text="Логин:" FontWeight="Normal" VerticalAlignment="Center" Margin="5,0,0,2"/>
				<TextBox x:Name="txtLogin" Style="{StaticResource DarkGreenTextBox}"/>

				<TextBlock Text="Пароль:" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,0,2"/>
				 <!--BorderBrush="{StaticResource SplitterBrush}"-->
				<PasswordBox x:Name="txtPassword" Style="{StaticResource DarkGreenPasswordBox}"/>

				<CheckBox x:Name="chkRemember" Content="Запомнить дорожный логин/пароль" 
                          Style="{StaticResource DarkGreenCheckBox}"/>

				<!-- 🔹 Блок 2: Центральный логин (REST API) -->
				<Separator Margin="5 10" Background="DarkRed" Height="2"/>

				<TextBlock Text="🌐 Центральный логин:" FontWeight="Normal" Margin="0,0,0,5" Foreground="DarkBlue"/>

				<TextBlock Text="Логин:" FontWeight="Normal" VerticalAlignment="Center" Margin="5,0,0,2"/>
				<!--BorderBrush="{StaticResource SplitterBrush}"-->
				<TextBox x:Name="txtCentralLogin" Style="{StaticResource DarkGreenTextBox}"/>

				<TextBlock Text="Пароль:" VerticalAlignment="Center" FontWeight="Normal" Margin="5,0,0,2"/>
				<!--BorderBrush="{StaticResource SplitterBrush}"--> 
				<PasswordBox x:Name="txtCentralPassword" Style="{StaticResource DarkGreenPasswordBox}"/>

				<CheckBox x:Name="chkRememberCentral" Content="Запомнить центральный логин/пароль" 
                          Style="{StaticResource DarkGreenCheckBox}"/>

				<!-- 🔹 Кнопки -->
				<Separator Margin="5 10" Background="DarkRed" Height="2"/>

				<Button x:Name="btnClearSettings" Content="🗑️ Очистить все сохранённые данные" 
                        Style="{StaticResource PopupStyleButton}" Click="btnClearSettings_Click" Margin="5,0,5,5"/>

				<Button x:Name="btnSaveSettings" Content="💾 Сохранить логины/пароли" 
                        Style="{StaticResource PopupStyleButton}" Click="btnSaveSettings_Click" Margin="5,0,5,5"/>

			</StackPanel>
		</GroupBox>
	</Expander>

</UserControl>
