<Window x:Class="Kas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KACAHT_Next2.Kas" 
		xmlns:properties="clr-namespace:KACAHT_Next2.My"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="KAC_AHT Next 2" 
        Icon="favicon.ico"
        Loaded="Window_Loaded"
        x:Name="MaiWinn"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        PreviewMouseDown="MaiWinn_PreviewMouseDown"
        Closing="MaiWinn_Closing"
        MinHeight="800" MinWidth="1800"
        >
	<Window.Resources>
		<Style TargetType="{x:Type ResizeGrip}">
			<Setter Property="Background" Value="Black"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ResizeGrip}">
						<Grid Background="Transparent"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"                           
                          Width="26"
                          Height="26">
							<Path Data="M26,26 L26,0 L0,26 Z"
								  Fill="{StaticResource SplitterBrush}"
                                  HorizontalAlignment="Right"
								  VerticalAlignment="Bottom"
								  Margin="0"/>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid x:Name="MWinMainGrig" >
		<!--#Region разделение строк окна для заголовка и контента-->
		<Grid.RowDefinitions>
			<RowDefinition Height="auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<!--#EndRegion-->

		<!--#Region Панель-заголовок окна-->
		<local:TitleBar x:Name="AppTBar" Grid.Row="0" />
		<!--#EndRegion-->

		<!--основная сетка маин виндов-->
		<Grid Grid.Row="1"
			  Background="{StaticResource AppBackBrush}" >

			<Grid.ColumnDefinitions>
				<ColumnDefinition x:Name="LeftColumn" MinWidth="530" MaxWidth="800" />
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!--левая панель-->
			<Grid Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition Height="auto"/>
					
					<RowDefinition Height="*"/>
					<RowDefinition Height="auto"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Margin="2">
					<local:KasConnectionIndicator x:Name="ConnIndicator"/>
					<local:KasCentralConnectionIndicator x:Name="CentralConnectionIndicator"/>
					<local:KasAuthControl x:Name="AuthCtrl" Margin="2" />
					<local:UstanowkiCTL x:Name="Ustanovki" Margin="2"/>
					<local:KasJournalParamControl x:Name="JourParam" Margin="2"/>
					<local:MainDataCTL x:Name="expDataWork" Margin="2" />
					<local:PoyasnilkaCTL x:Name="expPoyasnilka" Margin="2"/>
					<local:ExperimentalButtonsCTL x:Name="expExperimental" Margin="2"/>
				</StackPanel>
				
				
				<local:YarlykContainerControl  Grid.Row="1" Grid.Column="0" x:Name="YarlykContainer" />
				
				

				<local:InfoLBoxControl  Grid.Row="3" x:Name="InfoBLOK" MaxHeight="300" Margin="2 2 7 2"/>
			</Grid>


			<!--Разделитель колонок, надо чтобы родителем была общая колонка (0), поэтому Row тут не нужен-->
			<GridSplitter x:Name="MainWinSplitter" VerticalAlignment="Stretch" Width="5" Background="{StaticResource SplitterBrush}" Cursor="SizeWE"/>


			<Grid Grid.Column="1">

				<Grid.RowDefinitions>
					<!--<RowDefinition Height="auto"/>-->
					<!-- Панель управления -->
					<!--<RowDefinition Height="*"/>-->
					<!-- Основной контент -->
				</Grid.RowDefinitions>

				<!-- Многостраничный контейнер -->
				<TabControl x:Name="MainTabControl"
                            Background="{StaticResource AppBackBrush}"
                            BorderBrush="{StaticResource SplitterBrush}"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource TabItemRes}">

					<!-- Вкладка 1: Таблица отказов -->
					<TabItem x:Name="MainPage"
                             Header="Нормальный Журнал оповещений" 
                             Padding="2 2"
                             FontSize="13">
						<Grid Background="Transparent">
							<local:OTSBlockControl x:Name="TRowsContainer" />
						</Grid>
					</TabItem>
					<!---->
					<!-- Вкладка 2: Сводная статистика -->
					<TabItem Header="Сводная статистика"
                             x:Name="TabSummary"
                             Padding="2,2"
                             FontSize="13"
							 IsVisibleChanged="TabSummary_IsVisibleChanged"
                             Visibility="Collapsed">

						<Grid Background="Transparent">
							<!--<local:S24Table1 x:Name="S24Table1Ctrl"/>-->
						</Grid>
					</TabItem>

					<TabItem x:Name="OTSCard"
                             Visibility="Collapsed"
                             Padding="2,2"
                             FontSize="13">
						<local:OTSInfoCard x:Name="OTSInfoCard1" CurrentOtkaz="{Binding Source={x:Static local:OTSControlModule.BindingPoint}}" />

					</TabItem>
				</TabControl>
			</Grid>
		</Grid>

		<!-- 👇 ДОБАВИЛИ Popup СРАЗУ ПОСЛЕ Grid -->
		<local:DoubleCalendarControl x:Name="DContrPop"/>
		<local:SingleCalendarControl x:Name="SContrPop"/>
		<local:SingleCalendarControl x:Name="SharedCalendar" Visibility="Collapsed" />
		
		<Popup	x:Name="SerLokPopup"
				Placement="Center"
				StaysOpen="False"
				AllowsTransparency="True">
				<local:SerLokPopup x:Name="SerLokContent" />
		</Popup>

		<Popup	x:Name="EquipmentPopup" 
				Placement="Center" 
				StaysOpen="False" 
				AllowsTransparency="True">
				<local:EquipmentHierarchyPopup x:Name="EquipmentContent" />
		</Popup>
		

		<Popup	x:Name="IstochPopup"
				Placement="Center"
				StaysOpen="False"
				AllowsTransparency="True">
				<local:IstochnikControl x:Name="IstochContent" />
		</Popup>

		

		<Popup	x:Name="PripisMash"
				Placement="Center"
				StaysOpen="False"
				AllowsTransparency="True">
				<local:PripisMashinistaPopup x:Name="PripMashPopup" />
		</Popup>

		<!-- Попап передачи отказа -->
		<Popup	x:Name="PeredachaPopup"
				Placement="Center"
				StaysOpen="False"
				AllowsTransparency="True">
			<local:PeredachaPopupContent 
				x:Name="PeredachaPopContent"
				Confirmed="PeredachaPopContent_Confirmed"
				Canceled="PeredachaPopContent_Canceled"/>
		</Popup>

		
		<local:SmokeCanvas	x:Name="SmokeOverlay"
							Visibility="Collapsed"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch" />
		

	</Grid>
</Window>
